[Unit]
Description=Dunking Sheep dispatcher: fill idle lanes from the standby queue
After=default.target dunkingsheep.service

[Service]
# Pane-less timers prove the system role with a token (docs/FLAT_FLEET.md 4.2);
# without it they are anonymous and every write is refused.
Environment=DUNKINGSHEEP_SERVICE_TOKEN_FILE=%h/.config/dunkingsheep/system-token
Type=oneshot
ExecStart=/home/hunter/.local/bin/dunkingsheep dispatch tick
TimeoutStartSec=240
# A tick that outlives its socket deadline is SLOW, not broken: the CLI exits
# 75 ('still working after Ns') and that is not a unit failure.
SuccessExitStatus=75
