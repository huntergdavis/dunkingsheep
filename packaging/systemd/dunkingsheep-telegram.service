[Unit]
# FLAT_FLEET.md 7.2 (t594): the bridge sends owner-mailbox REPLIES for the telegram
# transport plus watchdog pages, and nothing else - a brief, a digest or a web echo
# has no path to the phone.
Description=Dunking Sheep Telegram bridge (answers Telegram questions only)
After=network-online.target dunkingsheep-web.service
Wants=network-online.target

[Service]
Type=simple
# t594: the install lays releases down as releases/<sha>/ and creates NO `current`
# symlink and NO per-release .venv (measured 2026-10-29: `ls releases/305702a*/`
# has no .venv, and `ls ~/.local/share/dunkingsheep/` has no `current`), so the
# previous ExecStart could only ever fail with 203/EXEC. Point the unit at a path
# the install really creates; %h is expanded by systemd.
WorkingDirectory=%h/.local/share/dunkingsheep/current
ExecStart=/usr/bin/python3 bridges/telegram_bridge.py
# The bridge is a UNIT, so it proves the system role: that is the role that owns
# owner_ingest / owner_outbox / owner_delivered (dunk_roles ALLOW["system"]). It
# was pointed at web-token, which is the owner's transport, not the bridge's.
Environment=DUNKINGSHEEP_SERVICE_TOKEN_FILE=%h/.config/dunkingsheep/system-token
# The variable the code actually reads is DUNKINGSHEEP_DIR (dunk_inbox.py,
# dunk_client.py, dunk_poolrad.py, dunk_views.py, dunk_superusers.py). This line
# said DUNKING_SHEEP_DIR, which no module reads, so it was silently ignored.
Environment=DUNKINGSHEEP_DIR=%h/.local/share/dunkingsheep/current
Environment=VP_DATA_DIR=%h/.config/dunkingsheep/desk
Environment=VP_CHANNELS_FILE=%h/.config/dunkingsheep/desk/channels.json
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
