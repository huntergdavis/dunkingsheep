[Unit]
# The transport-only policy (Telegram carries answers to Telegram questions and
# nothing else, FLAT_FLEET.md 7.2) is NOT in this build: bridges/telegram_bridge.py
# still forwards desk briefs. It lands with t594 (PR #135); until then this unit is
# described as what it does, not as what is planned.
Description=Dunking Sheep Telegram bridge (desk briefs + answers; answers-only lands with t594)
After=network-online.target dunkingsheep-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hunter/.local/share/dunkingsheep/current
ExecStart=/home/hunter/.local/share/dunkingsheep/current/.venv/bin/python bridges/telegram_bridge.py
Environment=DUNKINGSHEEP_SERVICE_TOKEN_FILE=%h/.config/dunkingsheep/web-token
Environment=DUNKING_SHEEP_DIR=/home/hunter/.local/share/dunkingsheep/current
Environment=VP_DATA_DIR=%h/.config/dunkingsheep/desk
Environment=VP_CHANNELS_FILE=%h/.config/dunkingsheep/desk/channels.json
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
