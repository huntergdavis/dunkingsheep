[Unit]
# FLAT_FLEET.md 7.2 (t594): the bridge sends owner-mailbox REPLIES for the telegram
# transport plus watchdog pages, and nothing else - a brief, a digest or a web echo
# has no path to the phone.
Description=Dunking Sheep Telegram bridge (answers Telegram questions only)
After=network-online.target dunkingsheep-web.service
Wants=network-online.target

[Service]
Type=simple
# t710 review of #143: the previous ExecStart named ~/.local/share/dunkingsheep/
# current/.venv/bin/python, but the install creates NEITHER a `current` symlink NOR
# a per-release .venv, so the unit failed at chdir (200/CHDIR) before it could even
# fail at exec. Every working unit here (watchdog, poolrad, dispatch) runs the
# installed CLI wrapper instead - a stable path the installer writes - so this one
# does the same and the release path stops being a guess.
ExecStart=/home/hunter/.local/bin/dunkingsheep --no-start-daemon telegram-bridge run
Environment=DUNKINGSHEEP_SERVICE_TOKEN_FILE=%h/.config/dunkingsheep/system-token
# NO WorkingDirectory: no working unit sets one, and there is no `current` to point at.
# NO DUNKINGSHEEP_DIR: that variable is the CONFIG directory, not the install
# (dunk_core/dunk_inbox/dunk_tasks/dunk_roles build CONFIG_DIR from it, and
# dunk_server derives SOCKET_PATH and LOG_FILE from CONFIG_DIR). Setting it to a
# release path would send the bridge looking for the daemon socket, the role registry
# and inbox.db under the release tree - worse than the misspelled line it replaced,
# which was merely ignored.
Environment=VP_DATA_DIR=%h/.config/dunkingsheep/desk
Environment=VP_CHANNELS_FILE=%h/.config/dunkingsheep/desk/channels.json
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
