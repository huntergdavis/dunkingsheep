[Unit]
Description=Dunking Sheep daemon (agent nerve center, memory, tasks)
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/hunter/.local/bin/dunkingsheep serve
Restart=always
RestartSec=2
Environment=DUNKINGSHEEP_MEMORY_THROTTLE_S=0.1
Environment=PATH=/home/hunter/.local/bin:/usr/local/bin:/usr/bin:/bin
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
