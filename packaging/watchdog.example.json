{
  "schema": "dunkingsheep-watchdog/2",
  "enabled": false,
  "dry_run": true,
  "cadence_minutes": 10,
  "min_run_spacing_seconds": 60,
  "max_alerts_per_run": 20,
  "state_path": "~/.config/dunkingsheep/watchdog_state.json",
  "heartbeat_path": "~/.config/dunkingsheep/watchdog.heartbeat",
  "state_retention_days": 14,
  "stores": {
    "config_dir": "~/.config/dunkingsheep"
  },
  "panes": {
    "source": "herdr",
    "pane_id_pattern": "^w[0-9A-Za-z]+:p[0-9A-Za-z]+$"
  },
  "escalation": {
    "vp": {
      "mailbox": "vp of agentry",
      "min_severity": "warning"
    },
    "owner": {
      "enabled": false,
      "channel": "desk-brief",
      "classes": ["security", "outage", "money"],
      "min_severity": "critical",
      "approved_by": null,
      "max_pages_per_hour": 3,
      "confirm_within_minutes": 15,
      "confirm_path": "~/workspace/vp-of-agentry/data/telegram-status.json"
    }
  },
  "rules": {
    "task.blocked_stale": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 1440, "must_hold_runs": 1,
      "threshold_minutes": 1440
    },
    "task.lease_stale": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 240, "must_hold_runs": 1,
      "never_renewed_minutes": 30, "lookback_minutes": 1440
    },
    "dunk.skip_loop": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 1440, "must_hold_runs": 1,
      "consecutive_skips": 10, "lookback_hours": 168
    },
    "dunk.overdue": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 240, "must_hold_runs": 1,
      "missed_intervals": 3
    },
    "inbox.undeliverable": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 1440, "must_hold_runs": 1,
      "min_messages": 1
    },
    "inbox.unread_live": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 240, "must_hold_runs": 1,
      "age_minutes": 240, "min_messages": 1
    },
    "inbox.unread_dead": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 1440, "must_hold_runs": 1,
      "min_messages": 1
    },
    "inbox.ambiguous_sender": {
      "enabled": true, "severity": "info", "class": "ops", "cooldown_minutes": 10080, "must_hold_runs": 1,
      "lookback_hours": 168, "sample_ids": 12, "require_live_pane": true
    },
    "lane.working_without_task": {
      "enabled": true, "severity": "info", "class": "ops", "cooldown_minutes": 1440, "must_hold_runs": 1,
      "quiet_minutes": 120
    },
    "lane.idle_holding_task": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 240, "must_hold_runs": 1,
      "quiet_minutes": 60, "idle_statuses": ["idle"], "holding_statuses": ["in_progress"]
    },
    "host.load": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 60, "must_hold_runs": 1,
      "load1_per_cpu": 2.0
    },
    "host.tmp": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 60, "must_hold_runs": 1,
      "max_used_fraction": 0.7, "critical_used_fraction": 0.9, "min_free_bytes": 1073741824,
      "max_inode_fraction": 0.9, "path": "/tmp"
    },
    "host.disk_full": {
      "enabled": true, "severity": "critical", "class": "outage", "cooldown_minutes": 30, "must_hold_runs": 2,
      "max_used_fraction": 0.98, "paths": ["/tmp", "/"]
    },
    "host.heavy_slot_stale": {
      "enabled": true, "severity": "warning", "class": "ops", "cooldown_minutes": 60, "must_hold_runs": 1,
      "directory": "/tmp", "prefix": "poolrad-heavy.", "max_age_minutes": 30
    },
    "security.secret_text": {
      "enabled": true, "severity": "critical", "class": "security", "cooldown_minutes": 525600, "must_hold_runs": 1,
      "patterns": [
        "ghp_[A-Za-z0-9]{36}",
        "github_pat_[A-Za-z0-9_]{60,}",
        "sk-ant-[A-Za-z0-9_-]{20,}",
        "\\bsk-[A-Za-z0-9]{32,}\\b",
        "\\bAKIA[0-9A-Z]{16}\\b",
        "\\bxox[abprs]-[A-Za-z0-9-]{10,}",
        "\\b[0-9]{8,10}:[A-Za-z0-9_-]{35}\\b",
        "-----BEGIN [A-Z ]*PRIVATE KEY-----"
      ],
      "allowlist_sha256": [],
      "lookback_hours": 168
    },
    "money.spend_projection": {
      "enabled": false, "severity": "critical", "class": "money", "cooldown_minutes": 1440, "must_hold_runs": 2,
      "source": null, "cap": null
    },
    "health.failed": {
      "enabled": true, "severity": "critical", "class": "ops", "cooldown_minutes": 60, "must_hold_runs": 1,
      "stale_minutes": 30
    }
  }
}
