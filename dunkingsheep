def print_load(r):
    print(f"window {r.get('elapsed_s')}s | host load1 {r.get('host_load1')} "
          f"| attributed {r.get('attributed_cores')} cores | "
          f"unattributed {r.get('unattributed_cores')} cores")
    if not r.get("callers"):
        print("no registered callers with pid+starttime (nothing is assumed)")
    for row in r.get("callers", []):
        gpu = row.get("gpu_pct") or {}
        gpu_text = f"{gpu['value']}%" if gpu.get("value") is not None else f"null ({gpu.get('reason')})"
        print(f"  {row['name']:<24} {str(row.get('cpu_pct')):>6}%  peak {row.get('peak_cpu_pct')}%"
              f"  rss {row.get('rss_mb')}MB  procs {row.get('process_count')}  gpu {gpu_text}")
    for item in r.get("would_kill", []):
        print(f"  {item['line']}{'' if item['kill'] else ' [alert-only]'}")
    for skip in r.get("skipped", []):
        print(f"  {skip['name']:<24} skipped: {skip['reason']}")


