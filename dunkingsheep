def _context_body(args):
    if getattr(args, "text", None):
        return args.text
    if getattr(args, "file", "-") == "-":
        return sys.stdin.read()
    try:
        return open(args.file).read()
    except FileNotFoundError:
        raise Refused(f"no such file: {args.file!r} - the body comes from --text, stdin or a file")


def _context_via_daemon(args):
    """context add/promote/supersede/retire over the socket, role-gated there."""
    from dunk_client import FlockClient, DaemonUnavailable
    project_path = None if getattr(args, "global_store", False) else \
        os.path.abspath(getattr(args, "path", None) or ".dunkingsheep")
    sub = args.context_command
    try:
        client = FlockClient(socket_path=args.socket, self_pane_id=args.self_pane)
        if sub == "add":
            result = client.call("context_add", body=_context_body(args), cls=args.cls,
                                 subject=args.subject, type=args.type_,
                                 authority=args.authority, source=args.source,
                                 stated=args.stated, recheck_after=args.recheck_after,
                                 supersedes=args.supersedes,
                                 global_store=bool(args.global_store), project_path=project_path)
            print(f"added {result['class']}/{result['slug']}")
        elif sub == "promote":
            result = client.call("context_promote", slug=args.slug,
                                 global_store=bool(args.global_store), project_path=project_path)
            print(f"promoted {result['slug']}")
        elif sub == "supersede":
            result = client.call("context_supersede", slug=args.slug, body=_context_body(args),
                                 global_store=bool(args.global_store), project_path=project_path)
            print(f"superseded by {result['slug']}")
        else:
            result = client.call("context_retire", slug=args.slug, reason=args.reason,
                                 global_store=bool(args.global_store), project_path=project_path)
            print(f"retired {result['slug']}")
        return 0
    except (DunkError, Refused) as error:
        print(f"refused: {error}", file=sys.stderr)
        return 2
    except (DaemonUnavailable, OSError) as error:
        print(f"daemon unavailable ({error}); the owner may write locally with --local",
              file=sys.stderr)
        return 1


def _git_credential(client, operation):
    """git credential protocol on stdin/stdout: only `get` for https github.com,
    and only when this lane's role implies an App; otherwise print nothing so git
    falls through to the owner's own helpers."""
    attrs = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if not line:
            break
        key, _sep, value = line.partition("=")
        attrs[key] = value
    if operation != "get":
        return {}
    if attrs.get("protocol") != "https" or attrs.get("host") != "github.com":
        return {}
    try:
        result = client.call("gh_token")
    except Exception:  # noqa: BLE001 - no daemon means no token, not a broken git
        return {}
    if not result.get("token"):
        return {}
    sys.stdout.write(f"username=x-access-token\npassword={result['token']}\n")
    sys.stdout.flush()
    return {}


def _github_local(args):
    """Owner's one-shot setup with their own `gh` login (never a lane path)."""
    import dunk_github
    import subprocess as _sp
    if args.github_command == "wrappers":
        result = dunk_github_wrappers_install(args.bin_dir)
        for key, value in result.items():
            print(f"{key:<20} {value}")
        return 0
    if args.github_command == "protect":
        reviewer = dunk_github.load_app("reviewer")
        payload = dunk_github.protection_payload(
            args.approvals, reviewer["id"],
            bypass_app_slug=reviewer["slug"] if args.bypass_reviewer_app else None)
        if args.dry_run:
            print(json.dumps(payload, indent=2))
            return 0
        proc = _sp.run(["gh", "api", "-X", "PUT",
                        f"repos/{args.repo}/branches/main/protection", "--input", "-"],
                       input=json.dumps(payload), capture_output=True, text=True)
        if proc.returncode != 0:
            print(proc.stderr.strip() or proc.stdout.strip(), file=sys.stderr)
            return proc.returncode
        proc2 = _sp.run(["gh", "api", "-X", "PATCH", f"repos/{args.repo}", "--input", "-"],
                        input=json.dumps({"allow_auto_merge": True,
                                          "delete_branch_on_merge": True}),
                        capture_output=True, text=True)
        print(f"protected {args.repo}: {args.approvals} approval(s), "
              f"{dunk_github.REVIEW_CONTEXT} required (app {reviewer['id']}), "
              f"auto-merge {'on' if proc2.returncode == 0 else 'NOT enabled: ' + proc2.stderr.strip()}")
        return 0
    return 2


GH_WRAPPER = """#!/bin/sh
# dunkingsheep gh wrapper: lanes act as their GitHub App; the owner keeps their login.
# Installed by `dunkingsheep github wrappers`; do not edit.
tok=$(dunkingsheep --no-start-daemon gh-token --quiet 2>/dev/null)
if [ -n "$tok" ]; then
  GH_TOKEN="$tok" exec __REAL_GH__ "$@"
fi
exec __REAL_GH__ "$@"
"""


def dunk_github_wrappers_install(bin_dir):
    import shutil
    import stat
    import subprocess as _sp
    bin_dir = os.path.expanduser(bin_dir)
    os.makedirs(bin_dir, exist_ok=True)
    real = None
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "gh")
        if (os.path.realpath(directory) != os.path.realpath(bin_dir)
                and os.path.isfile(candidate) and os.access(candidate, os.X_OK)):
            with open(candidate, "rb") as handle:
                if b"dunkingsheep gh wrapper" in handle.read(300):
                    continue
            real = candidate
            break
    if not real:
        raise SystemExit("no real `gh` found on PATH to wrap")
    target = os.path.join(bin_dir, "gh")
    with open(target, "w", encoding="utf-8") as handle:
        handle.write(GH_WRAPPER.replace("__REAL_GH__", real))
    os.chmod(target, os.stat(target).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    helper = "!dunkingsheep git-credential"
    key = "credential.https://github.com.helper"
    # t599: this used --replace-all and DROPPED the owner's own
    # '!gh auth git-credential', so his interactive login stopped being a fallback for
    # every repo he touched. Ours goes FIRST (it is the lane credential) and every
    # helper that was already there stays behind it, in the order it was in.
    existing = [row for row in _sp.run(["git", "config", "--global", "--get-all", key],
                                       capture_output=True, text=True).stdout.splitlines()
                if row.strip()]
    wanted = [helper] + [row for row in existing if row != helper]
    if existing != wanted:
        _sp.run(["git", "config", "--global", "--unset-all", key], check=False)
        for row in wanted:
            _sp.run(["git", "config", "--global", "--add", key, row], check=False)
    return {"gh_wrapper": target, "real_gh": real, "git_credential_helper": helper,
            "helpers": wanted,
            "note": "lanes use https remotes; our helper is first and any helper already "
                    "configured (the owner's gh login) is kept as the fallback "
                    "(gh-token prints nothing for the owner role)"}


