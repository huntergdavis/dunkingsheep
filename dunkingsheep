def _inbox_rows(messages):
    if not messages:
        print("no messages")
        return
    print(f"{'ID':<6} {'STATE':<9} {'FROM':<22} {'WAITING':>8} {'BYTES':>7} SUBJECT")
    for m in messages:
        waiting = f"{m['waiting_s']}s" if m.get("waiting_s") is not None else "-"
        subject = m.get("subject") or ""
        if m.get("attachments"):
            subject += f"  [{len(m['attachments'])} attachment(s)]"
        print(f"{m['message_id']:<6} {m['state']:<9} {_clip(m.get('sender') or '-', 22):<22} "
              f"{waiting:>8} {m['body_bytes']:>7} {_clip(subject, 44)}")


