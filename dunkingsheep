def print_clear(result):
    """A clear is not a message: it reports the state it found and the state it left.

    Using print_message here raised KeyError 'target_label' and made the one
    command that unblocks a lane the one command that could not run.
    """
    label = result.get("target_label") or result.get("pane_id")
    before = (result.get("before") or {}).get("state")
    if result.get("flushed"):
        after = (result.get("after") or {}).get("state")
        print(f"cleared {label} ({result.get('pane_id')}): {before} -> {after}"
              + (f" [{result['reason']}]" if result.get("reason") else ""))
    else:
        print(f"nothing cleared on {label} ({result.get('pane_id')}): {result.get('reason')}")


def print_messages(result):
    queued, recent = result.get("queued", []), result.get("recent", [])
    if not queued and not recent:
        print("no messages")
        return
    if queued:
        print(f"{'ID':<5} {'WAITING':>8} {'TARGET':<28} {'FROM':<10} TEXT")
        for m in queued:
            print(f"{m['message_id']:<5} {str(m['waiting_s']) + 's':>8} "
                  f"{_clip(m['target_label'], 28):<28} {_clip(m['source'], 10):<10} "
                  f"{_clip((m['text'] or '').replace(chr(10), ' '), 50)}")
            if m.get("blocked_by"):
                print(f"{'':<5} {'':>8} blocked by {m['blocked_by']}")
    if recent:
        if queued:
            print()
        print(f"{'ID':<5} {'STATUS':<10} {'TARGET':<28} {'FROM':<10} TEXT")
        for m in recent:
            print(f"{m['message_id']:<5} {m['status']:<10} "
                  f"{_clip(m['target_label'], 28):<28} {_clip(m['source'], 10):<10} "
                  f"{_clip((m['text'] or '').replace(chr(10), ' '), 50)}")


def print_workspaces(result):
    workspaces = result.get("workspaces", [])
    if not workspaces:
        print("no workspaces (is the terminal backend reachable? on the herdr rollback: is the herdr server running?)")
        return
    own = result.get("self") or {}
    for ws in workspaces:
        mark = "*" if ws.get("workspace_id") == own.get("workspace_id") else " "
        print(f"{mark}{ws.get('workspace_id'):<6} {_clip(ws.get('label'), 30):<30} "
              f"{ws.get('tab_count', len(ws.get('tabs', []))):>3} tabs  "
              f"{ws.get('agent_status') or '-'}")
        for tab in ws.get("tabs", []):
            mark = "*" if tab.get("tab_id") == own.get("tab_id") else " "
            print(f"   {mark}{tab.get('tab_id'):<8} {_clip(tab.get('label'), 30):<30} "
                  f"{tab.get('pane_count', 0):>3} panes {tab.get('agent_status') or '-'}")
    if own:
        print(f"* = this pane's workspace/tab")


def print_created(result):
    ws, tab, pane = result.get("workspace"), result.get("tab"), result.get("pane") or {}
    parts = []
    if ws:
        parts.append(f"workspace {ws.get('workspace_id')} {ws.get('label')!r}")
    if tab:
        parts.append(f"tab {tab.get('tab_id')} {tab.get('label')!r}")
    parts.append(f"pane {pane.get('pane_id')}")
    line = "created " + ", ".join(parts)
    if result.get("ran"):
        line += f"; running {result['ran']!r}"
    print(line)
    if result.get("error"):
        print(result["error"], file=sys.stderr)


def print_herdr(result):
    if result.get("error"):
        print(f"herdr error: {result['error']}", file=sys.stderr)
    if result.get("result") is not None:
        print(json.dumps(result["result"], indent=2))
    elif result.get("text"):
        sys.stdout.write(result["text"] if result["text"].endswith("\n") else result["text"] + "\n")


def print_poll(result):
    status = result.get("status") or {}
    count = result.get("inbox_count") or {}
    print(f"self {status.get('self_pane_id') or '?'}  v{status.get('version')}  "
          f"dunks {status.get('running', 0)}/{status.get('dunkers', 0)} running  "
          f"inbox {count.get('unread', 0)} unread / {count.get('total', 0)}")
    if result.get("error"):
        print(f"  note: {result['error']}")
    for message in (result.get("dunks") or {}).get("messages", [])[:5]:
        print(f"  #{message.get('message_id')} {message.get('sender')}: "
              f"{message.get('subject') or '(no subject)'}")
    for dunk in (result.get("dunks") or {}).get("dunks", [])[:10]:
        state = "running" if dunk.get("running") else "stopped"
        print(f"  {dunk.get('id')} {state} every {dunk.get('interval_minutes')}m "
              f"-> {dunk.get('target_label') or dunk.get('target_pane_id')}")


def print_status(result):
    """Status, with the code's identity beside the constant.

    'is the running daemon the code I just wrote' must be one line to answer, and a
    hand-maintained constant cannot answer it: this file said 2.37.4 for eight
    commits whose messages claimed 2.38 through 2.51.
    """
    version = result.get("version")
    code = result.get("code_hash")
    if version and code:
        print(f"{'version':<16} {version} (code {code})")
    elif version:
        print(f"{'version':<16} {version}")
    for key in ("code_mtime", "started_at", "code_stale", "pid", "dunkers", "running",
                "queued_messages", "herdr_available",
                "herdr_hint", "state_file", "uptime_s", "self_pane_id", "message"):
        value = result.get(key)
        if value in (None, "") and key != "code_stale":
            continue
        if key in ("code_mtime", "started_at"):
            value = f"{time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(value))} ({int(time.time() - value)}s ago)"
        if key == "code_stale":
            if value is None:
                errors = ", ".join(result.get("code_identity_errors") or [])
                value = "UNKNOWN - source identity unavailable" + (f": {errors}" if errors else "")
            elif value:
                names = ", ".join(result.get("code_changed_modules") or [])
                value = "YES - code on disk differs from this process; restart it"
                if names:
                    value += f" ({names})"
            else:
                value = "no"
        print(f"{key:<16} {value}")


