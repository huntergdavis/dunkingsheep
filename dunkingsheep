#!/usr/bin/env python3
"""
dunkingsheep - command-line control of Dunking Sheep.

    dunkingsheep add --target "Codex hunterdavis.com" --every 15 --text continue
    dunkingsheep list
    dunkingsheep remove d3
    dunkingsheep send self "hello from the future"
    dunkingsheep panes
    dunkingsheep tui           # the curses UI
    dunkingsheep mcp           # MCP server on stdio (for Claude Code etc.)
    dunkingsheep serve         # run the daemon in the foreground

Every subcommand except `serve`, `tui` and `mcp` is a thin client of the
daemon over its unix socket; the daemon is started automatically if it is not
running. Add `--json` for machine-readable output.
"""

import argparse
import json
import os
import shlex
import socket
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from dunk_client import DaemonUnavailable, FlockClient  # noqa: E402
from dunk_core import VERSION, DunkError, format_interval  # noqa: E402
from dunk_help import SHORT, guide  # noqa: E402
from dunk_tasks import PRIORITIES as TASK_PRIORITIES, STATUSES as TASK_STATUSES  # noqa: E402

CLI_ABS = os.path.abspath(__file__)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="dunkingsheep",
        description="Send text into terminal panes on a schedule; control it from the "
                    "keyboard, this CLI, a unix socket, or MCP.",
        epilog=SHORT,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    import dunk_core as _core
    parser.add_argument("--version", action="version",
                        version=f"dunkingsheep {VERSION} (code "
                                f"{_core.CODE_IDENTITY.get('code_hash') or 'unknown'})")
    parser.add_argument("--json", action="store_true", help="print raw JSON results")
    parser.add_argument("--socket", help="daemon socket path (default: $DUNKINGSHEEP_SOCKET "
                                         "or ~/.config/dunkingsheep/dunkingsheep.sock)")
    parser.add_argument("--self-pane", help="pane id to use for target 'self' "
                                            "(default: $TMUX_PANE, or $HERDR_PANE_ID on the rollback)")
    parser.add_argument("--no-start-daemon", action="store_true",
                        help="fail instead of auto-starting the daemon")
    # `--json` is also accepted after the subcommand (agents tend to put it last).
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help=argparse.SUPPRESS)
    # `--json` is also accepted after the subcommand (agents tend to put it last) - at ANY depth.
    # The top-level subparsers get `parents=[common]` explicitly; nested ones used to default to
    # type(parent), which is a plain ArgumentParser WITHOUT the flag, so `dispatch tick --json` and
    # `owner stats --json` were rejected with "unrecognized arguments: --json" (pi-review-1, t257).
    # One class for every level means the flag's position stops mattering.
    json_parser_class = lambda **kw: argparse.ArgumentParser(parents=[common], **kw)
    sub = parser.add_subparsers(dest="command", metavar="<command>",
                                parser_class=json_parser_class)
    sub.required = True

    p = sub.add_parser("allocation", help="registered-worker automatic backlog/review allocation")
    p.add_argument("action", choices=["status", "register", "offer", "review"])
    p.add_argument("--pane-id")
    p.add_argument("--pool")
    p.add_argument("--pools", action="append")
    p.add_argument("--roles", action="append", choices=["worker", "reviewer"])
    p.add_argument("--skills", action="append")
    p.add_argument("--requires", action="append")
    p.add_argument("--task-id")
    p.add_argument("--revision")
    p.add_argument("--body")
    p.add_argument("--disable", action="store_true")

    p = sub.add_parser("status", help="daemon health and counts")
    p.add_argument("--check-herdr", action="store_true",
                   help="probe the terminal backend (slow; default off)")
    p = sub.add_parser("turn", help="declare a busy turn (pi/claude hooks)")
    tsub = p.add_subparsers(dest="turn_command", metavar="<start|end>", parser_class=json_parser_class)
    tsub.required = True
    q = tsub.add_parser("start", help="mark the pane busy until turn end")
    q.add_argument("--pane", help="pane id (default: the caller's)")
    q.add_argument("--ttl-s", type=float)
    q.add_argument("--source")
    q.add_argument("--handoff-id", help="next-job id from the initiating prompt")
    q = tsub.add_parser("end", help="end the busy turn and release the hold")
    q.add_argument("--pane", help="pane id (default: the caller's)")
    q.add_argument("--reason")
    q.add_argument("--turn-id", help="generation returned by --json turn start")
    p = sub.add_parser("poll", help="one batched read for sidebars: status + inbox + dunks",
                       description="Read-only batch used by the sidebar poller. "
                                   "It does not mark mail read; panes/tasks are opt-in.")
    p.add_argument("--mailbox", help="mailbox to poll (default: the caller's)")
    p.add_argument("--limit", type=int, default=5, help="unread messages to return (default 5)")
    p.add_argument("--panes", action="store_true", help="include the pane list (slow; startup only)")
    p.add_argument("--tasks", action="store_true", help="include the caller's task queue")
    p.add_argument("--task-scope", choices=["global", "self"], default=None)
    p.add_argument("--include-done", action="store_true")
    p.add_argument("--check-herdr", action="store_true",
                   help="probe the terminal backend (slow; default off)")
    p = sub.add_parser("list", aliases=["ls"], help="list all dunks",
                       description="List every dunk: id, running, live status, target, "
                                   "interval, sends (done/max), idle gate, text.")

    p = sub.add_parser("get", help="show one dunk")
    p.add_argument("id")

    p = sub.add_parser(
        "add", help="create a dunk (starts immediately)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Create a dunk that types TEXT + Enter into TARGET every EVERY minutes.",
        epilog="examples:\n"
               "  dunkingsheep add -T \"Codex Site\" -e 15 -t continue\n"
               "  dunkingsheep add -T w8:p3 -e 1.5h -t \"status report please\" -n hourly\n"
               "  dunkingsheep add -T self -e 30 --max-sends 1 -t \"check CI now\"\n"
               "  dunkingsheep add -T self -e 60 --only-idle --skip-if-unconsumed \\\n"
               "      -t \"If the backlog is done: dunkingsheep remove {id}. Else continue.\"\n"
               "placeholders in TEXT: {id} {name} {count} {target} {interval} {time} {date}",
    )
    p.add_argument("--target", "-T", help="pane id, 'self', or a unique label substring")
    p.add_argument("--text", "-t", default="continue",
                   help="text to send (default 'continue'); {id} etc. are expanded")
    p.add_argument("--every", "-e", "--interval", dest="every", default="10",
                   help="interval: minutes, or e.g. 90s / 1.5h (default 10)")
    p.add_argument("--name", "-n", help="label for the dunk")
    p.add_argument("--only-idle", action="store_true",
                   help="hold each send until the target agent is idle")
    p.add_argument("--max-sends", type=int, help="remove the dunk after N sends")
    p.add_argument("--skip-if-unconsumed", action="store_true",
                   help="backpressure: skip a send if the previous one was never picked up")
    p.add_argument("--ignore-typing", action="store_true",
                   help="send even while someone is typing in the target's input box "
                        "(default: hold and re-check every minute)")
    p.add_argument("--no-start", action="store_true", help="create it stopped")

    p = sub.add_parser("update", aliases=["set"], help="change a dunk's settings")
    p.add_argument("id")
    p.add_argument("--target", "-T")
    p.add_argument("--text", "-t")
    p.add_argument("--every", "-e", "--interval", dest="every")
    p.add_argument("--name", "-n")
    gate = p.add_mutually_exclusive_group()
    gate.add_argument("--only-idle", action="store_true")
    gate.add_argument("--any-time", action="store_true", help="clear only-idle gating")
    p.add_argument("--max-sends", type=int, help="0 clears the limit")
    bp = p.add_mutually_exclusive_group()
    bp.add_argument("--skip-if-unconsumed", action="store_true",
                    help="backpressure: skip a send if the previous one was never picked up")
    bp.add_argument("--always-send", action="store_true", help="clear skip-if-unconsumed")
    typing = p.add_mutually_exclusive_group()
    typing.add_argument("--hold-while-typing", action="store_true",
                        help="hold a send while someone is typing in the target (default)")
    typing.add_argument("--ignore-typing", action="store_true",
                        help="send even while someone is typing in the target")

    for name, aliases, help_text in (
        ("remove", ["rm", "delete"], "delete a dunk"),
        ("start", [], "start a dunk"),
        ("stop", [], "stop a dunk"),
        ("toggle", [], "start if stopped, stop if running"),
    ):
        p = sub.add_parser(name, aliases=aliases, help=help_text)
        p.add_argument("id")

    sub.add_parser("stop-all", help="stop every running dunk")

    p = sub.add_parser("fire", aliases=["test"], help="send a dunk's text now")
    p.add_argument("id")
    p.add_argument("--countdown", type=int, default=0, help="seconds to count down first")

    p = sub.add_parser("send", help="type text + Enter into a pane once (queued if someone is typing)",
                       epilog="example: dunkingsheep send \"Claude Proj\" please summarize your progress")
    p.add_argument("target")
    p.add_argument("text", nargs="+")
    p.add_argument("--wait", type=float, default=10, metavar="S",
                   help="block up to S seconds for delivery before returning (default 10)")
    p.add_argument("--ignore-typing", action="store_true",
                   help="send even while someone is typing (default: queue it)")
    p.add_argument("--desk-token", help=argparse.SUPPRESS)

    p.add_argument("--no-enter", action="store_true",
                   help="leave the text in the box without pressing Enter")

    p = sub.add_parser("send-keys", help="press keys in a pane (queued if someone is typing)",
                       epilog="example: dunkingsheep send-keys \"Codex Site\" Enter")
    p.add_argument("target")
    p.add_argument("keys", nargs="+")
    p.add_argument("--wait", type=float, default=10, metavar="S",
                   help="block up to S seconds for delivery before returning (default 10)")
    p.add_argument("--ignore-typing", action="store_true",
                   help="press them even while someone is typing (default: queue)")
    p.add_argument("--desk-token", help=argparse.SUPPRESS)

    p = sub.add_parser("install", help="put `dunkingsheep` on PATH as a plain command",
                       description="Install a launcher so agents can run `dunkingsheep "
                                   "inbox read` as an ordinary command, instead of "
                                   "executing a file inside this workspace, which a "
                                   "sandboxed agent should and does refuse.")
    p.add_argument("--bin-dir", default="~/.local/bin",
                   help="where to install it (default ~/.local/bin)")

    p = sub.add_parser("guard", help="install the herdr guard (rollback backend) so agents cannot type over you",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       description="Agents that call the terminal CLI directly bypass every "
                                   "protection in the daemon. On the herdr rollback backend the guard "
                                   "is a herdr wrapper, first on PATH, that routes exactly the four "
                                   "typing commands through the daemon instead. Every other herdr "
                                   "command is untouched.",
                       epilog="new shells pick it up; existing panes need a fresh shell")
    p.add_argument("action", nargs="?", default="status",
                   choices=["status", "install", "install-tmux", "uninstall", "check", "shadow", "unshadow"])
    p.add_argument("--no-shadow", action="store_true",
                   help="install the PATH wrapper only; do not take herdr's own place "
                        "(agents the herdr server starts itself will not be covered)")

    # -- inboxes --------------------------------------------------------------
    inbox = sub.add_parser("inbox", help="per-agent inboxes: messaging that never types",
                           description="Machine-to-machine messaging. A message is stored "
                                       "for the recipient agent to read, so it cannot "
                                       "collide with a human typing, cannot stick "
                                       "half-sent, and has no size limit.")
    isub = inbox.add_subparsers(dest="inbox_command", metavar="<subcommand>", parser_class=json_parser_class)
    isub.required = True
    q = isub.add_parser("count", help="how many messages are waiting")
    q.add_argument("mailbox", nargs="?", help="agent name, pane id or 'self' (default self)")
    q = isub.add_parser("send", help="put a message in an agent's inbox",
                        epilog="example: dunkingsheep inbox send reviewer 'PR 12 is ready' -s 'review'")
    q.add_argument("to")
    q.add_argument("body", nargs="*")   # may come from --body-file instead
    q.add_argument("--subject", "-s")
    q.add_argument("--attach", "-a", action="append", metavar="PATH",
                   help="attach a local file (repeatable)")
    q.add_argument("--no-notify", action="store_true",
                   help="do not nudge the recipient's pane")
    q.add_argument("--literal", action="store_true",
                   help="send body text that contains shell-substitution syntax ($( ${ or a backtick)")
    q.add_argument("--body-file", metavar="PATH",
                   help="read the body from a file ('-' for stdin): immune to shell substitution")
    q = isub.add_parser("list", help="summaries of waiting messages")
    q.add_argument("mailbox", nargs="?")
    q.add_argument("--all", action="store_true", help="include messages already read")
    q.add_argument("--limit", "-n", type=int, default=50)
    q = isub.add_parser("read", help="read waiting messages and mark them read")
    q.add_argument("mailbox", nargs="?")
    q.add_argument("--limit", "-n", type=int, default=10)
    q.add_argument("--peek", action="store_true", help="do not mark them read")
    q = isub.add_parser("recover", help="replay the latest delivered batch after a lost read response")
    q.add_argument("mailbox", nargs="?", help="agent name, pane id or 'self' (default self)")
    q = isub.add_parser("archive", help="archive a mailbox in bulk (no deletion)")
    q.add_argument("mailbox")
    q.add_argument("--before", help="only messages created before this ISO date/time or epoch")
    q.add_argument("--state", default="queued,acked",
                   help="comma-separated states to archive (default queued,acked)")

    q = isub.add_parser("status", help="state of one message by id")
    q.add_argument("message_id")
    for name, help_text in (("ack", "mark messages handled"),
                            ("cancel", "withdraw unread messages you sent"),
                            ("delete", "delete messages and their attachments")):
        q = isub.add_parser(name, help=help_text)
        q.add_argument("message_ids", nargs="+")
        if name == "ack":
            q.add_argument("--mailbox", help="only ack this mailbox (default: your own)")
    isub.add_parser("stats", help="unread counts for every mailbox")
    q = isub.add_parser("fetch", help="write an attachment to a local directory")
    q.add_argument("attachment_id")
    q.add_argument("--dest", "-d", default=".")

    # -- context store ---------------------------------------------------------
    context = sub.add_parser("context", help="declarative context store: files are truth, index is a cache",
                             description=".dunkingsheep/ per project plus one global. Ground truths never "
                                         "expire; only the owner promotes one; supersede keeps both entries linked.")
    csub = context.add_subparsers(dest="context_command", metavar="<subcommand>", parser_class=json_parser_class)
    csub.required = True
    q = csub.add_parser("init", help="create the store layout")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--path")
    q = csub.add_parser("add", help="add an entry (body from --text, stdin or a file)")
    q.add_argument("file", nargs="?", default="-")
    q.add_argument("--text", help="the body inline (otherwise stdin or the file argument)")
    q.add_argument("--class", dest="cls", required=True)
    q.add_argument("--subject", required=True)
    q.add_argument("--type", dest="type_", default="reference")
    q.add_argument("--authority", default="agent")
    q.add_argument("--source", default="")
    q.add_argument("--stated")
    q.add_argument("--recheck-after")
    q.add_argument("--supersedes")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--local", action="store_true", help=argparse.SUPPRESS)
    q = csub.add_parser("promote", help="owner-only: promote an entry to ground truth")
    q.add_argument("slug")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--local", action="store_true", help=argparse.SUPPRESS)
    q = csub.add_parser("supersede", help="replace an entry, keeping both linked")
    q.add_argument("slug")
    q.add_argument("file", nargs="?", default="-")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--local", action="store_true", help=argparse.SUPPRESS)
    q = csub.add_parser("retire", help="append a retirement note (history kept)")
    q.add_argument("slug")
    q.add_argument("--reason", default="")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--local", action="store_true", help=argparse.SUPPRESS)
    q = csub.add_parser("ledger", help="what the daemon wrote: adopt (owner bootstrap) or status")
    q.add_argument("action", choices=["adopt", "status"])
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--path")
    q = csub.add_parser("get", help="show an entry by subject or slug")
    q.add_argument("key")
    q.add_argument("--global", dest="global_store", action="store_true")
    q = csub.add_parser("search", help="FTS5 search over the disposable index")
    q.add_argument("query")
    q.add_argument("--class", dest="cls")
    q.add_argument("--scope")
    q.add_argument("--global", dest="global_store", action="store_true")
    q = csub.add_parser("digest", help="bounded session digest (global truths always included)")
    q.add_argument("--subject")
    q.add_argument("--max-bytes", type=int, default=8192)
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--project", action="store_true")
    q.add_argument("--path")
    q = csub.add_parser("snapshot", help="digest + per-article access counts, for the dashboard")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--project", action="store_true")
    q.add_argument("--path")
    q = csub.add_parser("check", help="schema, refusals and stale facts (both stores by default)")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--project", action="store_true")
    q.add_argument("--path")
    q = csub.add_parser("index", help="rebuild the disposable FTS index (both stores by default)")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--project", action="store_true")
    q.add_argument("--path")
    q = csub.add_parser("stats", help="counts, ages, reads and never-read entries (both stores by default)")
    q.add_argument("--global", dest="global_store", action="store_true")
    q.add_argument("--project", action="store_true")
    q.add_argument("--path")

    # -- per-caller load -------------------------------------------------------
    load = sub.add_parser("load", help="per-caller CPU from /proc (pid+starttime guarded, process tree)",
                          description="Sample registered callers' CPU from /proc. Identity is pid+starttime; "
                                      "a reused pid produces no sample. GPU is null with a reason on this hardware.")
    load.add_argument("--policies", metavar="PATH",
                      help="JSON {agent: policy}; adds dry-run would-kill lines (default: load-policies.json)")

    # -- project PMs -----------------------------------------------------------
    pm = sub.add_parser("pm", help="project PMs: lane routing and the one-per-project digest",
                        description="A PM publishes ONE digest per project per window "
                                    "under a stable id, and lanes report to their PM "
                                    "instead of the VP.")
    psub = pm.add_subparsers(dest="pm_command", metavar="<subcommand>", parser_class=json_parser_class)
    psub.required = True
    q = psub.add_parser("digest", help="publish/update one project digest",
                        epilog="example: echo '{\"changed\":[\"t6 240/286\"],\"numbers\":[]}' | "
                               "dunkingsheep pm digest poolrad")
    q.add_argument("project")
    q.add_argument("--to", help="VP pane (default from routing / DUNKINGSHEEP_VP_PANE)")
    q.add_argument("--demo", action="store_true",
                   help="label the subject DEMO (a shape demo carries live numbers, not template ones)")
    q = psub.add_parser("routing", help="show the lane->PM routing registry")

    # -- tasks ----------------------------------------------------------------
    task = sub.add_parser(
        "task", help="global and per-pane tasks: the coordination queue",
        description="Tasks are global (fleet-wide) by default, or scoped to one "
                    "pane. `task next` claims atomically; `task follow` asks the "
                    "daemon to push work to you when idle.")
    tsub = task.add_subparsers(dest="task_command", metavar="<subcommand>", parser_class=json_parser_class)
    tsub.required = True

    q = tsub.add_parser("add", help="create a task")
    q.add_argument("title")
    q.add_argument("--scope", help="'global' (default), 'self' or a pane id")
    q.add_argument("--body", "-b", default="")
    q.add_argument("--status", choices=list(TASK_STATUSES), default="open")
    q.add_argument("--priority", "-p", choices=list(TASK_PRIORITIES), default="low")
    q.add_argument("--assign", "-a", action="append", metavar="PANE",
                   help="assignee pane id/agent name (repeatable; 'self' = caller)")
    q.add_argument("--depends-on", "-d", action="append", metavar="ID",
                   help="task id that must be done first (repeatable)")
    q.add_argument("--parent", metavar="ID", help="parent task id (subtask)")
    q.add_argument("--multi", action="store_true",
                   help="allow several agents to claim this task")
    q.add_argument("--kind", choices=["work", "review", "verify", "report"], default="work")
    q.add_argument("--author", help="lane that produced the artefact under review")
    q.add_argument("--repo", help="owner/name (reviews)")
    q.add_argument("--pr", type=int, help="PR number (reviews)")
    q.add_argument("--head", help="exact commit under review (reviews)")

    q = tsub.add_parser("list", aliases=["ls"], help="list visible tasks")
    q.add_argument("scope", nargs="?", help="'global', 'self' or a pane id")
    q.add_argument("--status", choices=list(TASK_STATUSES))
    q.add_argument("--assignee", metavar="PANE")
    q.add_argument("--all", action="store_true", help="include done/cancelled")
    q.add_argument("--limit", "-n", type=int, default=200)
    q.add_argument("--kind", choices=["work", "review", "verify", "report"])
    q.add_argument("--needs-owner", action="store_true",
                   help="only tasks blocked on a 'needs-owner:' question")

    q = tsub.add_parser("read", help="read one task in full")
    q.add_argument("id")

    q = tsub.add_parser("update", help="change a task")
    q.add_argument("id")
    q.add_argument("--title")
    q.add_argument("--body", "-b")
    q.add_argument("--status", choices=list(TASK_STATUSES))
    q.add_argument("--priority", "-p", choices=list(TASK_PRIORITIES))
    q.add_argument("--assign", "-a", action="append", metavar="PANE")
    q.add_argument("--depends-on", "-d", action="append", metavar="ID")
    q.add_argument("--parent", metavar="ID")
    q.add_argument("--block-reason", metavar="TEXT")
    q.add_argument("--multi", dest="multi_assignee", action="store_true", default=None)
    q.add_argument("--no-multi", dest="multi_assignee", action="store_false")

    q = tsub.add_parser("assign", help="assign a task (use 'self' for yourself)")
    q.add_argument("id")
    q.add_argument("assignees", nargs="+")
    q.add_argument("--mode", choices=["add", "remove", "set"], default="add")

    q = tsub.add_parser("complete", help="complete a task for everyone")
    q.add_argument("id")
    q.add_argument("--by")
    q.add_argument("--verdict", choices=["accept", "needs-fix"],
                   help="review tasks: the verdict (recorded from your bound lane)")

    q = tsub.add_parser("block", help="mark a task blocked")
    q.add_argument("id")
