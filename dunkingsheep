def mcp_map_text(markdown=False):
    """Render the t8 OLD -> NEW tool map (text or markdown)."""
    from dunk_api import COMMANDS, grouped_mcp_tools, mcp_commands, mcp_tool_map
    tool_map = mcp_tool_map()
    flat = mcp_commands()
    grouped = grouped_mcp_tools()
    flat_bytes = len(json.dumps([{"name": c.name, "description": c.description,
                                  "inputSchema": c.input_schema()} for c in flat]))
    grouped_bytes = len(json.dumps([{"name": t.name, "description": t.description,
                                     "inputSchema": t.input_schema()} for t in grouped]))
    hot = [t for t in grouped if t.name in ("inbox", "task", "memory")]
    hot_bytes = len(json.dumps([{"name": t.name, "inputSchema": t.input_schema()}
                                for t in hot]))
    if not markdown:
        lines = [
            f"declared {len(grouped)} grouped tools (was {len(flat)} flat); "
            f"schema {grouped_bytes} bytes (was {flat_bytes}); "
            f"hot set (inbox, task, memory) {hot_bytes} bytes",
            "",
        ]
        for tool in grouped:
            actions = ", ".join(tool.actions)
            lines.append(f"{tool.name}: {actions}")
        lines.append("")
        for command in flat:
            entry = tool_map[command.name]
            lines.append(f"{command.name} -> {entry['tool']}(action={entry['action']})")
        for command in (c for c in COMMANDS if not c.mcp):
            lines.append(f"{command.name} -> (CLI/socket only)")
        return "\n".join(lines) + "\n"

    out = [
        "# MCP tool map (t8 grouping audit)",
        "",
        "The declared MCP surface is one namespaced tool per domain, each taking "
        "an `action`. Nothing was removed: every flat name still resolves, and "
        "every command stays on the CLI/socket API.",
        "",
        f"- declared tools: **{len(grouped)}** grouped (was **{len(flat)}** flat)",
        f"- grouped schema bytes: **{grouped_bytes}** (was **{flat_bytes}**, "
        f"-{100 * (1 - grouped_bytes / flat_bytes):.1f}%)",
        f"- hot set (`inbox`, `task`, `memory`): **{hot_bytes}** bytes "
        "(target <10 KB)",
        "",
        "## Grouped tools",
        "",
        "| Tool | Actions |",
        "| --- | --- |",
    ]
    for tool in grouped:
        out.append(f"| `{tool.name}` | " + ", ".join(f"`{a}`" for a in tool.actions) + " |")
    out += ["", "## OLD flat tool -> NEW grouped tool", "",
            "| Old tool | New tool | action |", "| --- | --- | --- |"]
    for command in flat:
        entry = tool_map[command.name]
        out.append(f"| `{command.name}` | `{entry['tool']}` | `{entry['action']}` |")
    out += ["", "## CLI/socket-only commands (not MCP tools)", "",
            "| Command | Why |", "| --- | --- |",
            "| `shutdown` | daemon stop; CLI/socket only |"]
    return "\n".join(out) + "\n"


def _be_nice():
    """A poller must not outrank an interactive agent. Courtesy, not a fix."""
    try:
        if os.environ.get("DUNKINGSHEEP_NICE") != "0":
            os.nice(int(os.environ.get("DUNKINGSHEEP_NICE", "5")))
    except (AttributeError, OSError, ValueError):
        pass


_POLL_COMMANDS = ("status", "list", "ls", "poll")
_INBOX_POLLS = ("count", "list", "ls", "stats")


def _coalesce(argv):
    """Return the cache path when this poll command may reuse a recent answer.

    Ten lanes polling faster than they can act is pure overhead, but a
    suppressed call must not lose the ANSWER: an interactive caller that asks
    once must still get the count. The cache stores stdout under the key; a
    coalesced caller replays it and marks stderr as cached. DUNKINGSHEEP_FRESH=1
    bypasses the cache for a caller that needs certainty.
    """
    if os.environ.get("DUNKINGSHEEP_FRESH") == "1":
        return None
    try:
        minimum = float(os.environ.get("DUNKINGSHEEP_MIN_POLL_S", "2"))
    except ValueError:
        minimum = 2.0
    if minimum <= 0:
        return None
    words = [word for word in argv if not word.startswith("-")]
    if not words:
        return None
    if words[0] == "inbox":
        if len(words) < 2 or words[1] not in _INBOX_POLLS:
            return None
        key = "inbox-" + words[1]
    elif words[0] in _POLL_COMMANDS:
        key = words[0]
    else:
        return None
    path = os.path.join("/tmp", "dunkingsheep-poll-" + str(os.getuid()) + "-" + key)
    now = time.time()
    try:
        last = os.path.getmtime(path)
    except OSError:
        last = 0.0
    if last and now - last < minimum:
        return path
    try:
        open(path, "a").close()
        os.utime(path, (now, now))
    except OSError:
        return None
    # Return the path even on creation: _run writes the fresh stdout there so
    # the next call inside the interval can replay it instead of a stub.
    return path


def _run(argv):
    """Run main(), caching the stdout of a coalescable command.

    A cache hit replays the previous stdout (same fields) and writes a
    {"coalesced": true, "cached": true} marker to stderr; the caller parses the
    same answer it would have parsed fresh.
    """
    path = _coalesce(argv)
    if path:
        try:
            with open(path + ".out", encoding="utf-8") as handle:
                cached = handle.read()
        except OSError:
            cached = ""
        if cached:
            sys.stdout.write(cached)
            print(json.dumps({"coalesced": True, "cached": True,
                              "interval_s": float(os.environ.get(
                                  "DUNKINGSHEEP_MIN_POLL_S", "2"))}),
                  file=sys.stderr)
            return 0
        # No cached answer yet: run fresh rather than return a silent stub.
    import contextlib
    import io
    buffer = io.StringIO()
    try:
        with contextlib.redirect_stdout(buffer):
            code = main(argv)
    except SystemExit as exc:
        # argparse --version/--help print inside the capture and then exit;
        # the captured text must still reach stdout.
        code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    output = buffer.getvalue()
    if path:
        try:
            with open(path + ".out", "w", encoding="utf-8") as handle:
                handle.write(output)
        except OSError:
            pass
    sys.stdout.write(output)
    return code


def main(argv=None):
    parser = build_parser()
    words = list(argv if argv is not None else sys.argv[1:])
    if not words:
        parser.print_help()
        return 0
    _be_nice()
    _coalesce(words)
    args = parser.parse_args(words)
    command = args.command

    if command in ("guide", "help", "docs"):
        sys.stdout.write(guide(markdown=args.markdown))
        return 0
    if command == "mcp-map":
        sys.stdout.write(mcp_map_text(markdown=args.markdown))
        return 0
    if command == "mcp-setup":
        return run_mcp_setup(args)
    if command == "install":
        import dunk_guard
        result = dunk_guard.install_launcher(args.bin_dir)
        if getattr(args, "json", False):
            print(json.dumps(result, indent=2))
        else:
            for key, value in result.items():
                print(f"{key:<16} {value}")
            if not result["resolves_to"]:
                print("\nNote: %s is not on this shell's PATH." % args.bin_dir)
            print("\nSuperuser setup: run `dunkingsheep superuser recover` "
                  "from the VP pane, then `dunkingsheep superuser status`.")
        return 0
    if command == "guard":
        import dunk_guard
        if args.action == "install":
            result = dunk_guard.install(shadow_binary=not args.no_shadow)
        elif args.action == "install-tmux":
            result = dunk_guard.install_tmux()
        else:
            result = getattr(dunk_guard, args.action)()
        if getattr(args, "json", False):
            print(json.dumps(result, indent=2))
        else:
            for key, value in result.items():
                print(f"{key:<22} {value}")
            if args.action == "install":
                print("\nOpen a new shell (or run: export PATH=\"%s:$PATH\") so agents "
                      "pick it up." % dunk_guard.GUARD_DIR)
        return 0 if result.get("ok", True) else 1

    if command == "watchdog":
        # Local and read-only: evaluates the stores directly and never starts
        # the daemon. Only a live run talks to it, to deliver one digest.
        import dunk_watchdog
        error_file = os.path.expanduser(args.error_file)
        try:
            config = dunk_watchdog.load_config(os.path.expanduser(args.config))
        except dunk_watchdog.ConfigError as error:
            message = f"CONFIG: {error}"
            print(f"watchdog: refusing to start: {message}", file=sys.stderr)
            if not args.dry_run and not args.replay:
                # The dead-man carries this text to the VP; nothing is sent from here.
                os.makedirs(os.path.dirname(error_file) or ".", exist_ok=True)
                with open(error_file, "w", encoding="utf-8") as handle:
                    handle.write(message + "\n")
            return 2
        if os.path.exists(error_file) and not args.dry_run and not args.replay:
            os.remove(error_file)
        live = config["enabled"] and not config["dry_run"] and not args.dry_run and not args.replay
        if live and args.now is not None:
            # A live run stamps state and the heartbeat with `now`; a backdated one
            # would make the dead-man fire falsely (or stay silent). Refuse it.
            print("watchdog: refusing --now on a live run (use --dry-run or --replay)", file=sys.stderr)
            return 2
        now = args.now if args.now is not None else time.time()
        if args.replay:
            if args.replay_from is None or not args.replay_step:
                print("watchdog: --replay needs --from and --step", file=sys.stderr)
                return 2
            result = dunk_watchdog.replay(config, args.replay_from, args.replay_to or now, args.replay_step)
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                for rule_id, count in sorted(result["counts"].items()):
                    print(f"REPLAY rule={rule_id} would_notify_vp={count['vp']} would_page_owner={count['owner']}")
                for rule_id in result["not_replayable"]:
                    print(f"REPLAY rule={rule_id} not replayable")
                for entry in result["errors"]:
                    print(f"SKIPPED rule={entry['rule']} at={entry['at']} error={entry['error']}")
            return 0
        report = dunk_watchdog.run(config, now, dry_run_flag=args.dry_run)
        print(json.dumps(report, indent=2, sort_keys=True, default=str) if args.json
              else dunk_watchdog.render_text(report))
        return 1 if report["delivery_error"] else 0
    if command == "usage":
        import dunk_usage
        try:
            config = dunk_usage.load_config(os.path.expanduser(args.config))
            results = dunk_usage.run(config, only=args.provider, max_age=args.max_age)
        except dunk_usage.UsageError as error:
            print(f"usage: {error}", file=sys.stderr)
            return 2
        print(json.dumps(results, indent=2, sort_keys=True) if args.json
              else dunk_usage.render_text(results))
        return 1 if any(item.get("status") == "error" for item in results) else 0
    if command == "watchdog-deadman":
        # Must not import dunk_watchdog: it has to work when the watchdog is broken.
        import dunk_watchdog_deadman
        from dunk_server import SOCKET_PATH, CONFIG_DIR
        args.daemon_path = SOCKET_PATH if args.daemon_path is None else os.path.expanduser(args.daemon_path)
        args.expected_dir = os.path.expanduser(args.expected_dir or CONFIG_DIR)
        return dunk_watchdog_deadman.main(args)
    if command == "serve":
        from dunk_server import SOCKET_PATH, run_daemon
        return run_daemon(
            socket_path=args.socket or SOCKET_PATH,
            state_file=args.state_file,
            log_to_file=not args.no_log_file,
        )
    if command == "tui":
        if args.socket:
            os.environ["DUNKINGSHEEP_SOCKET"] = args.socket
        from dunking_sheep_tui import main as tui_main
        tui_main()
        return 0
    if command == "mcp":
        if args.socket:
            os.environ["DUNKINGSHEEP_SOCKET"] = args.socket
        if args.self_pane:
            os.environ["HERDR_PANE_ID"] = args.self_pane
        from dunk_mcp import main as mcp_main
        mcp_main()
        return 0
    if command == "commands":
        from dunk_api import COMMANDS
        if args.json:
            print(json.dumps([
                {"name": c.name, "description": c.description,
                 "input_schema": c.input_schema(), "mcp_tool": c.mcp}
                for c in COMMANDS
            ], indent=2))
            return 0
        for cmd in COMMANDS:
            params = ", ".join(
                f"{key}{'*' if key in cmd.required else ''}" for key in cmd.params
            )
            flag = "" if cmd.mcp else "  [socket/cli only]"
            print(f"{cmd.name}({params}){flag}\n    {cmd.description}")
        return 0

    try:
        # A send may ask the daemon to block for --wait seconds; the socket read
        # has to outlast that or the CLI reports a timeout for a send that is
        # in fact queued and fine.
        wait = getattr(args, "wait", None)
        client = FlockClient.connect_or_start(
            socket_path=args.socket, self_pane_id=args.self_pane,
            start=not args.no_start_daemon,
        )
        if command == "health" and getattr(args, "deep", False):
            # A deep quick_check scans the whole DB; give it room.
            client.timeout = max(client.timeout, 180.0)
        if wait:
            client.timeout = max(client.timeout, float(wait) + 10.0)
        result, printer = run_client_command(client, args)
    except DunkError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    except (DaemonUnavailable, OSError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 3

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        printer(result)
    return 0


def run_client_command(client, args):
    """Map CLI args onto a registry command; return (result, human printer)."""
    command = args.command
    if command == "status":
        return client.call("status", check_herdr=args.check_herdr), print_status
    if command == "turn":
        if args.turn_command == "start":
            return client.call("turn_start", pane=args.pane, ttl_s=args.ttl_s,
                               source=args.source), \
                lambda r: print(f"turn start {r['pane_id']} ttl {r['ttl_s']}s")
        return client.call("turn_end", pane=args.pane,
                           reason=args.reason), \
            lambda r: print(f"turn end {r['pane_id']} (ended={r['ended']})")
    if command == "poll":
        payload = {"limit": args.limit, "panes": args.panes, "tasks": args.tasks,
                   "include_done": args.include_done,
                   "check_herdr": args.check_herdr}
        if args.mailbox:
            payload["mailbox"] = args.mailbox
        if args.task_scope:
            payload["task_scope"] = args.task_scope
        return client.call("poll", **payload), print_poll
    if command in ("list", "ls"):
        return client.call("list_dunks"), lambda r: print_dunks(r["dunks"])
    if command == "get":
        return client.call("get_dunk", id=args.id), print_dunk
    if command == "add":
        payload = {
            "text": args.text,
            "interval_minutes": args.every,
            "start": not args.no_start,
        }
        if args.target:
            payload["target"] = args.target
        if args.name:
            payload["name"] = args.name
        if args.only_idle:
            payload["only_when"] = "idle"
        if args.max_sends:
            payload["max_sends"] = args.max_sends
        if args.skip_if_unconsumed:
            payload["skip_if_unconsumed"] = True
        if args.ignore_typing:
            payload["hold_while_typing"] = False
        return client.call("add_dunk", **payload), print_dunk
    if command in ("update", "set"):
        payload = {"id": args.id}
        if args.target:
            payload["target"] = args.target
        if args.text is not None:
            payload["text"] = args.text
        if args.every is not None:
            payload["interval_minutes"] = args.every
        if args.name is not None:
            payload["name"] = args.name
        if args.only_idle:
            payload["only_when"] = "idle"
        elif args.any_time:
            payload["only_when"] = None
        if args.max_sends is not None:
            payload["max_sends"] = args.max_sends or None
        if args.skip_if_unconsumed:
            payload["skip_if_unconsumed"] = True
        elif args.always_send:
            payload["skip_if_unconsumed"] = False
        if args.hold_while_typing:
            payload["hold_while_typing"] = True
        elif args.ignore_typing:
            payload["hold_while_typing"] = False
        return client.call("update_dunk", **payload), print_dunk
    if command in ("remove", "rm", "delete"):
        return client.call("remove_dunk", id=args.id), lambda r: print(f"removed {r['id']}")
    if command == "start":
        return client.call("start_dunk", id=args.id), print_dunk
    if command == "stop":
        return client.call("stop_dunk", id=args.id), print_dunk
    if command == "toggle":
        return client.call("toggle_dunk", id=args.id), print_dunk
    if command == "stop-all":
        return client.call("stop_all"), lambda r: print_dunks(r["dunks"])
    if command in ("fire", "test"):
        result = client.call("fire_dunk", id=args.id, countdown_s=args.countdown, wait=True)
        return result, lambda r: print(
            f"{r['id']}: {'queued' if r.get('queued') else 'sent' if r['ok'] else 'FAILED'} "
            f"({r['message']})")
    if command == "send":
        result = client.call("send_text", target=args.target, text=" ".join(args.text),
                             hold_while_typing=not args.ignore_typing, wait_s=args.wait,
                             press_enter=not args.no_enter)
        return result, print_message
    if command == "send-keys":
        result = client.call("send_keys", target=args.target, keys=" ".join(args.keys),
                             hold_while_typing=not args.ignore_typing, wait_s=args.wait)
        return result, print_message
    if command == "inbox":
        sub = args.inbox_command
        if sub == "count":
            return client.call("inbox_count", mailbox=args.mailbox), print_inbox_count
        if sub == "send":
            return client.call("inbox_send", to=args.to, body=" ".join(args.body),
                               subject=args.subject,
                               attach=",".join(args.attach) if args.attach else None,
                               notify=not args.no_notify), print_inbox_sent
        if sub == "list":
            return client.call("inbox_list", mailbox=args.mailbox,
                               unread_only=not args.all, limit=args.limit), print_inbox_list
        if sub == "read":
            return client.call("inbox_read", mailbox=args.mailbox, limit=args.limit,
                               peek=args.peek), print_inbox_read
        if sub == "status":
            return client.call("inbox_status", message_id=args.message_id), print_inbox_status
        if sub in ("ack", "cancel", "delete"):
            return client.call(f"inbox_{sub}", message_ids=",".join(args.message_ids),
                               **({"mailbox": args.mailbox} if getattr(args, "mailbox", None) else {})), \
                lambda r: print(f"{r.get('state', sub)}: "
                                f"{', '.join(r.get('changed') or r.get('deleted') or []) or 'nothing'}"
                                + (f" in mailbox {r['acked_in']!r}" if r.get("acked_in") else "")
                                + (f"; unchanged {r['unchanged']}" if r.get("unchanged") else ""))
        if sub == "archive":
            return client.call("inbox_archive", mailbox=args.mailbox,
                               before=args.before, state=args.state), print_inbox_archive

        if sub == "stats":
            return client.call("inbox_stats"), print_inbox_stats
        if sub == "fetch":
            return client.call("inbox_fetch", attachment_id=args.attachment_id,
                               dest=args.dest), \
                lambda r: print(f"wrote {r['path']} ({r['size']} bytes)")
    if command == "context":
        import dunk_context
        sub = args.context_command
        store = dunk_context.Store(args.path if getattr(args, "path", None) else None,
                                   global_store=bool(getattr(args, "global_store", False)))
        if sub == "init":
            return {"root": str(store.ensure())}, lambda r: print(f"store at {r['root']}")
        if sub == "add":
            body = sys.stdin.read() if args.file == "-" else open(args.file).read()
            return store.add(body, cls=args.cls, subject=args.subject, type_=args.type_,
                             authority=args.authority, source=args.source, stated=args.stated,
                             recheck_after=args.recheck_after, supersedes=args.supersedes), \
                lambda r: print(f"added {r['class']}/{r['slug']}")
        if sub == "promote":
            entry = store.find(args.slug)
            if entry is None:
                raise SystemExit(1)
            if os.environ.get("DUNKINGSHEEP_SUPERUSER") != "1":
                raise SystemExit("refused: only an owner act promotes a ground truth")
            return store.add(entry["body"], cls="ground-truth", subject=entry["subject"],
                             type_=entry.get("type") or "principle", authority="owner",
                             source=entry.get("source") or "",
                             supersedes=entry["slug"]), lambda r: print(f"promoted {r['slug']}")
        if sub == "supersede":
            body = sys.stdin.read() if args.file == "-" else open(args.file).read()
            return store.supersede(args.slug, body), lambda r: print(f"superseded by {r['slug']}")
        if sub == "retire":
            return store.retire(args.slug, args.reason), lambda r: print(f"retired {r['slug']}")
        if sub in ("get", "search"):
            # The same scope rule as stats/check/digest: a lookup must find a
            # global ground truth from inside a project, or the rules are write-only.
            which = ("global" if getattr(args, "global_store", False)
                     else "project" if getattr(args, "project", False) else None)
            stores = dunk_context.select_stores(getattr(args, "path", None), which=which)
            if sub == "get":
                for name, target in stores.items():
                    entry = target.find(args.key)
                    if entry is not None:
                        target.log_access(entry["slug"])
                        return entry, lambda r: print(
                            f"# {r['slug']} ({r['class']}, {r['authority']}, {name})\n\n{r['body']}")
                raise SystemExit(f"no entry {args.key!r} in {', '.join(stores) or 'any store'}")
            rows = []
            for name, target in stores.items():
                for row in target.search(args.query, cls=args.cls, scope=args.scope):
                    rows.append(dict(row, store=name))
            return rows, lambda rs: [print(f"{r['store']:<8} {r['class']:<13} {r['slug']:<40} {r['subject']}")
                                     for r in rs] and None
        if sub == "digest":
            which = ("global" if getattr(args, "global_store", False)
                     else "project" if getattr(args, "project", False) else None)
            return dunk_context.digest_both(getattr(args, "path", None), which=which,
                                            max_bytes=args.max_bytes, subject=args.subject), print
        which = ("global" if getattr(args, "global_store", False)
                 else "project" if getattr(args, "project", False) else None)
        if sub in ("check", "index", "stats"):
            stores = dunk_context.select_stores(getattr(args, "path", None), which=which)
            out = {}
            for name, target in stores.items():
                if sub == "index":
                    out[name] = {"path": str(target.root), "result": target.index()}
                elif sub == "check":
                    result = target.check()
                    out[name] = {"path": str(target.root), "counts": result["counts"],
                                 "refusals": len(result["refusals"]), "stale": len(result["stale"]),
                                 "entries": sum(result["counts"].values())}
                else:
                    result = target.stats()
                    out[name] = {"path": str(target.root), "counts": result["counts"],
                                 "reads_7d": result["reads_7d"],
                                 "injected_7d": result["injected_7d"],
                                 "never_read_count": result["never_read_count"],
                                 "never_read": result["never_read"],
                                 "never_delivered_count": result["never_delivered_count"]}
            if sub == "index":
                return out, lambda r: [print(f"{name}: indexed {v['result']['indexed']} -> {v['result']['path']}")
                                       for name, v in r.items()] and None
            if sub == "check":
                return out, lambda r: [print(f"{name} ({v['path']}): entries {v['entries']}, refusals {v['refusals']}, stale {v['stale']}")
                                       for name, v in r.items()] and None
            return out, lambda r: [print(f"{name} ({v['path']}): counts {v['counts']}, "
                                        f"injected_7d {v['injected_7d']}, reads_7d {v['reads_7d']}, "
                                        f"never_delivered {v['never_delivered_count']}, "
                                        f"never_read {v['never_read_count']}") for name, v in r.items()] and None
    if command == "load":
        tasks = client.call("task_list", limit=500).get("tasks") or []
        callers = [{"caller_pid": t.get("caller_pid"), "caller_start": t.get("caller_start"),
                    "caller_name": t.get("caller_name")} for t in tasks]
        import dunk_load, json, os
        policies = None
        policy_path = args.policies or os.path.expanduser("~/.config/dunkingsheep/load-policies.json")
        try:
            with open(policy_path) as handle:
                policies = json.load(handle).get("agents") or json.load(handle)
        except (OSError, ValueError):
            policies = None
        result = dunk_load.collect(dunk_load.registered_callers(callers), policies=policies)
        if args.json:
            return result, None
        return result, print_load
    if command == "pm":
        sub = args.pm_command
        if sub == "digest":
            raw = sys.stdin.read()
            if args.demo:
                import json as _json
                try:
                    payload = _json.loads(raw) if raw.strip().startswith("{") else {"note": raw}
                except ValueError:
                    payload = {"note": raw}
                payload["demo"] = True
                raw = _json.dumps(payload)
            return client.call("pm_digest", project=args.project,
                               payload=raw, to=args.to), print_pm_digest
        if sub == "routing":
            return client.call("pm_routing"), print_pm_routing
    if command == "task":
        sub = args.task_command
        if sub == "add":
            return client.call("task_add", title=args.title, scope=args.scope,
                               body=args.body, status=args.status,
                               priority=args.priority,
                               assignees=args.assign or None,
                               depends_on=args.depends_on or None,
                               parent_id=args.parent,
                               multi_assignee=args.multi), print_task
        if sub in ("list", "ls"):
            return client.call("task_list", scope=args.scope, status=args.status,
                               assignee=args.assignee, include_done=args.all,
                               limit=args.limit), print_task_list
        if sub == "read":
            return client.call("task_read", id=args.id), print_task
        if sub == "update":
            payload = {"id": args.id}
            for key, value in (("title", args.title), ("body", args.body),
                               ("status", args.status), ("priority", args.priority),
                               ("parent_id", args.parent),
                               ("block_reason", args.block_reason)):
                if value is not None:
                    payload[key] = value
            if args.assign is not None:
                payload["assignees"] = args.assign
            if args.depends_on is not None:
                payload["depends_on"] = args.depends_on
            if args.multi_assignee is not None:
                payload["multi_assignee"] = args.multi_assignee
            return client.call("task_update", **payload), print_task
        if sub == "assign":
            return client.call("task_assign", id=args.id, assignees=args.assignees,
                               mode=args.mode), print_task
        if sub == "complete":
            return client.call("task_complete", id=args.id, by=args.by), print_task
        if sub == "block":
            return client.call("task_block", id=args.id, reason=args.reason), print_task
        if sub == "unblock":
            return client.call("task_unblock", id=args.id), print_task
        if sub == "cancel":
            return client.call("task_cancel", id=args.id, reason=args.reason), print_task
        if sub == "delete":
            return client.call("task_delete", id=args.id), \
                lambda r: print(f"deleted {r['deleted']}")
        if sub == "note":
            return client.call("task_note", id=args.id, event=args.event,
                               reason=args.reason), \
                lambda r: print(f"noted {r['noted']}: {r['event']}")
        if sub == "next":
            return client.call("task_next", scope=args.scope,
                               lease_seconds=args.lease), print_task_next
        if sub == "heartbeat":
            return client.call("task_heartbeat", id=args.id,
                               lease_seconds=args.lease), \
                lambda r: print(f"lease on {r['task_id']} extended "
                                f"({int(r['lease_seconds'])}s)")
        if sub == "release":
            return client.call("task_release", id=args.id), print_task
        if sub == "follow":
            return client.call("task_follow", scope=args.scope), \
                lambda r: print(f"following {r['scope']} as {r['pane_id']} "
                                f"({len(r['followers'])} follower(s))")
        if sub == "unfollow":
            return client.call("task_unfollow"), \
                lambda r: print("stopped following" if r["was_following"]
                                else "was not following")
        if sub == "followers":
            return client.call("task_followers"), print_task_followers
        if sub == "stats":
            return client.call("task_stats", scope=args.scope), print_task_stats
        if sub == "metrics":
            return client.call("task_metrics", scope=args.scope,
                               window_s=args.window, since=args.since,
                               until=args.until, bucket=args.bucket), \
                print_task_metrics
        if sub == "reap":
            return client.call("task_reap"), \
                lambda r: print(f"requeued {len(r['requeued'])} lease(s)"
                                + (f": {', '.join(x['task_id'] for x in r['requeued'])}"
                                   if r["requeued"] else ""))
    if command == "flush":
        return client.call("flush_box", target=args.target), lambda r: print(
            f"{r['target_label']} ({r['pane_id']}): {r['message']}"
            + (f" -> {r['text'][:60]!r}" if r.get("text") else ""))
    if command in ("messages", "queue"):
        return client.call("list_messages"), print_messages
    if command in ("cancel-message", "cancel"):
        return client.call("cancel_message", message_id=args.message_id), \
            lambda r: print(f"cancelled {r['message_id']} for {r['target_label']}")
    if command == "metrics":
        return client.call("metrics", window_s=args.window, since=args.since,
                           until=args.until), lambda r: print(json.dumps(r, indent=2))
    if command == "panes":
        return client.call("list_panes"), print_panes
    if command in ("workspaces", "tabs"):
        return client.call("list_workspaces"), print_workspaces
    if command in ("new-workspace", "workspace"):
        return client.call("create_workspace", label=args.label, cwd=args.cwd,
                           command=args.run, focus=args.focus), print_created
    if command in ("new-tab", "tab"):
        return client.call("create_tab", workspace=args.workspace, label=args.label,
                           cwd=args.cwd, command=args.run, focus=args.focus), print_created
    if command == "split":
        return client.call("split_pane", target=args.target,
                           direction="down" if args.down else "right", cwd=args.cwd,
                           command=args.run, focus=args.focus), print_created
    if command in ("start-agent", "agent"):
        return client.call("start_agent", name=args.name, command=shlex.join(args.argv),
                           workspace=args.workspace, tab=args.tab, split=args.split,
                           cwd=args.cwd, focus=args.focus), \
            lambda r: print(f"started agent {r['name']} in {r['pane_id']}: {shlex.join(r['argv'])}")
    if command == "rename":
        return client.call("rename", kind=args.kind, target=args.target, label=args.label), \
            lambda r: print(f"renamed {r['kind']} {r['id']} -> {r['label']!r}")
    if command == "focus":
        return client.call("focus", kind=args.kind, target=args.target), \
            lambda r: print(f"focused {r['kind']} {r['id']}")
    if command == "close":
        return client.call("close", kind=args.kind, target=args.target,
                           force=args.force), \
            lambda r: print(f"closed {r['kind']} {r['id']}; panes {', '.join(r['closed_panes']) or '-'}"
                            + (f"; stopped dunks {', '.join(r['stopped_dunks'])}" if r["stopped_dunks"] else ""))
    if command == "herdr":
        return client.call("herdr", command=shlex.join(args.argv)), print_herdr
    if command == "herdr-help":
        return client.call("herdr_help", topic=args.topic), \
            lambda r: sys.stdout.write(r["text"] if r["text"].endswith("\n") else r["text"] + "\n")
    if command == "read":
        return client.call("read_pane", target=args.target, lines=args.lines), \
            lambda r: sys.stdout.write(r["text"] if r["text"].endswith("\n") else r["text"] + "\n")
    if command == "superuser":
        sub = args.superuser_command
        if sub == "status":
            return client.call("superuser_status"), print_superuser
        if sub == "add":
            return client.call("superuser_add", entry=args.entry), print_superuser
        if sub == "remove":
            return client.call("superuser_remove", entry=args.entry), print_superuser
        if sub == "recover":
            return client.call("superuser_recover", name=args.name), print_superuser
    if command == "memory":
        sub = args.memory_command
        if sub in ("recall", "search"):
            call = "memory_recall" if sub == "recall" else "memory_search"
            return client.call(call, query=args.query, limit=args.limit,
                               harness=args.harness, project=args.project,
                               since=args.since), print_memory
        if sub == "context":
            return client.call("memory_context", query=args.query,
                               sessions=args.sessions), print_memory_context
        if sub == "hook-context":
            query = args.query or os.path.basename(os.getcwd())
            return client.call("memory_context", query=query,
                               sessions=args.sessions), print_memory_hook_context
        if sub == "stats":
            return client.call("memory_stats"), print_memory_stats
        if sub == "status":
            return client.call("memory_status"), print_memory_stats
        if sub == "ingest":
            return client.call("memory_ingest", path=args.path,
                               harness=args.harness, project=args.project), \
                lambda r: print(f"queued {r['path']} ({r['harness']})")
        if sub == "backfill":
            action = ("pause" if args.pause else "resume" if args.resume
                      else "status" if args.status else "start")
            return client.call("memory_backfill", action=action,
                               limit=args.limit), print_memory_backfill
    if command == "health":
        def render_health(result):
            print_health(result)
            if args.write is not None:
                from dunk_health import write_report
                path = write_report(result, args.write or None)
                print(f"  report written to {path}")
        return client.call("health", repair=args.repair,
                           deep=args.deep), render_health
    if command == "recover":
        return client.call("recover", apply=args.apply,
                           record=args.record), print_recover
    if command == "doctor":
        return client.call("doctor"), print_doctor
    if command == "shutdown":
        return client.call("shutdown", stop_all=args.stop_all), \
            lambda r: print("daemon shutting down" + (" (all dunks stopped)" if r["stopped_all"] else ""))
    raise DunkError(f"unhandled command {command}")


if __name__ == "__main__":
    sys.exit(_run(sys.argv[1:]))
