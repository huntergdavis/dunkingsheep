def mcp_map_text(markdown=False):
    """Render the t8 OLD -> NEW tool map (text or markdown)."""
    from dunk_api import COMMANDS, grouped_mcp_tools, mcp_commands, mcp_tool_map
    tool_map = mcp_tool_map()
    flat = mcp_commands()
    grouped = grouped_mcp_tools()
    flat_bytes = len(json.dumps([{"name": c.name, "description": c.description,
                                  "inputSchema": c.input_schema()} for c in flat]))
    grouped_bytes = len(json.dumps([{"name": t.name, "description": t.description,
                                     "inputSchema": t.input_schema()} for t in grouped]))
    hot = [t for t in grouped if t.name in ("inbox", "task", "memory")]
    hot_bytes = len(json.dumps([{"name": t.name, "inputSchema": t.input_schema()}
                                for t in hot]))
    if not markdown:
        lines = [
            f"declared {len(grouped)} grouped tools (was {len(flat)} flat); "
            f"schema {grouped_bytes} bytes (was {flat_bytes}); "
            f"hot set (inbox, task, memory) {hot_bytes} bytes",
            "",
        ]
        for tool in grouped:
            actions = ", ".join(tool.actions)
            lines.append(f"{tool.name}: {actions}")
        lines.append("")
        for command in flat:
            entry = tool_map[command.name]
            lines.append(f"{command.name} -> {entry['tool']}(action={entry['action']})")
        for command in (c for c in COMMANDS if not c.mcp):
            lines.append(f"{command.name} -> (CLI/socket only)")
        return "\n".join(lines) + "\n"

    out = [
        "# MCP tool map (t8 grouping audit)",
        "",
        "The declared MCP surface is one namespaced tool per domain, each taking "
        "an `action`. Nothing was removed: every flat name still resolves, and "
        "every command stays on the CLI/socket API.",
        "",
        f"- declared tools: **{len(grouped)}** grouped (was **{len(flat)}** flat)",
        f"- grouped schema bytes: **{grouped_bytes}** (was **{flat_bytes}**, "
        f"-{100 * (1 - grouped_bytes / flat_bytes):.1f}%)",
        f"- hot set (`inbox`, `task`, `memory`): **{hot_bytes}** bytes "
        "(target <10 KB)",
        "",
        "## Grouped tools",
        "",
        "| Tool | Actions |",
        "| --- | --- |",
    ]
    for tool in grouped:
        out.append(f"| `{tool.name}` | " + ", ".join(f"`{a}`" for a in tool.actions) + " |")
    out += ["", "## OLD flat tool -> NEW grouped tool", "",
            "| Old tool | New tool | action |", "| --- | --- | --- |"]
    for command in flat:
        entry = tool_map[command.name]
        out.append(f"| `{command.name}` | `{entry['tool']}` | `{entry['action']}` |")
    out += ["", "## CLI/socket-only commands (not MCP tools)", "",
            "| Command | Why |", "| --- | --- |",
            "| `shutdown` | daemon stop; CLI/socket only |"]
    return "\n".join(out) + "\n"


def _be_nice():
    """A poller must not outrank an interactive agent. Courtesy, not a fix."""
    try:
        if os.environ.get("DUNKINGSHEEP_NICE") != "0":
            os.nice(int(os.environ.get("DUNKINGSHEEP_NICE", "5")))
    except (AttributeError, OSError, ValueError):
        pass


# Read only local files; never open a socket.
LOCAL_ONLY_COMMANDS = ("context", "github")
# Long daemon-side work: the poolrad exporter runs for minutes, a launch
# verifies the process started, a review sync talks to GitHub. A 15 s read
# deadline reported "no answer" for work that then completed (2026-10-29, the
# first backlog-sync), and the timer unit recorded a failure for a success.
LONG_DAEMON_COMMANDS = frozenset({"poolrad", "review", "start-agent", "agent",
                                  "new-workspace", "workspace", "respawn-pane", "respawn"})
LONG_DAEMON_TIMEOUT_S = 600.0


def client_timeout_for(command, timeout):
    """The socket read deadline for `command`: never below the client's own,
    and at least LONG_DAEMON_TIMEOUT_S for the long daemon-side commands."""
    if command in LONG_DAEMON_COMMANDS:
        return max(float(timeout), LONG_DAEMON_TIMEOUT_S)
    return timeout
# Context WRITES go through the daemon (docs/FLAT_FLEET.md 8); reads stay local
# so the digest never waits on a socket. --local is the owner's bootstrap path.
CONTEXT_DAEMON_WRITES = ("add", "promote", "supersede", "retire")

# A synchronous send waits for delivery, and delivery reads panes several times.
# Under load (27 live lanes at 2.7/cpu) those reads are slow: 15 s was not enough
# for a fire that was working, and the client reported a timeout for a send that
# landed. This is a wait long enough to be honest about, not a retry.
SEND_TIMEOUT_S = float(os.environ.get("DUNKINGSHEEP_SEND_TIMEOUT_S", "120"))
BATCH_TIMEOUT_S = float(os.environ.get("DUNKINGSHEEP_BATCH_TIMEOUT_S", "180"))
# A batch that outlived its socket timeout is NOT an implementation failure: it is a
# bounded job that outgrew its deadline. Saying 'timed out' sends a reader hunting a
# hang that does not exist, so the exit code says 'temporary' and the unit can accept
# it as success.
EXIT_STILL_WORKING = 75
# A tick classifies every lane; it is a batch, not a single send.
BATCH_COMMANDS = ("dispatch",)


def _still_working_message(command, seconds):
    return (f"still working after {int(seconds)}s: {command} has not answered yet. "
            f"This is a pace problem, not a failure - the daemon keeps going and its "
            f"result lands in the state it writes (e.g. dispatch-state.json). "
            f"Raise DUNKINGSHEEP_BATCH_TIMEOUT_S or reduce the batch.")

# Commands that CHANGE state. After one of these, a cached read is not merely
# stale, it is a lie: "drain 200 messages, then count" returned the pre-drain count
# for up to DUNKINGSHEEP_MIN_POLL_S and I nearly filed a bug against working code
# (VP i24046 -> t89). A mutating command bumps a generation file; a cached answer
# carries the generation it was computed under, and a mismatch means recompute.
_MUTATING_COMMANDS = (
    "send", "send-keys", "fire", "flush", "clear-box", "start", "stop", "toggle",
    "stop-all", "add", "update", "set", "remove", "rm", "delete", "cancel",
    "cancel-message", "inbox", "task", "superuser", "whoami", "token", "lane", "lanes",
    "new-workspace", "workspace", "new-tab", "tab", "split", "start-agent", "agent",
    "respawn-pane", "respawn", "rename", "focus", "close", "retire", "retired", "owner", "state", "dispatch",
    "recover", "shutdown", "watchdog", "watchdog-deadman", "memory", "context",
)


# Subcommands that only READ, per mutating command. A flat list of commands was
# wrong in the obvious way: `task list` bumped the generation and therefore never
# hit its own cache. `inbox read` is NOT here on purpose - reading marks messages
# read, which is a write.
_READ_ONLY_SUBCOMMANDS = {
    "task": {"list", "ls", "read", "stats", "metrics", "followers", "get"},
    "inbox": {"count", "list", "ls", "stats", "status", "fetch"},
    "lane": {"list", "lanes"},
    "lanes": {"list"},
    "owner": {"stats"},
    "state": {"latest"},
    "retired": {"list"},
    "memory": {"recall", "context", "search", "stats", "status"},
    "context": {"get", "list", "search", "stats"},
    "dispatch": {"status", "list"},
    "superuser": {"status"},
    "workspace": {"list"},
    "workspaces": {"list"},
    "tab": {"list"},
    "tabs": {"list"},
    "agent": {"list"},
    "panes": {"list"},
}


def _is_mutating(words):
    """True when this invocation can change state, and so invalidates cached reads."""
    # Global options precede the command. Their separate values are not command
    # names: filtering only '-' words left '%35' at the front of
    # '--self-pane %35 inbox read', so the completed drain never invalidated a
    # cached inbox count. Equals forms and boolean globals consume one word.
    words = list(words)
    while words and words[0].startswith("-"):
        option = words.pop(0)
        if option in ("--self-pane", "--socket") and words:
            words.pop(0)
    words = [word for word in words if not word.startswith("-")]
    if not words:
        return False
    command = words[0]
    if command not in _MUTATING_COMMANDS:
        return False
    if len(words) > 1 and words[1] in _READ_ONLY_SUBCOMMANDS.get(command, set()):
        return False
    return True


def _generation_path():
    scope = (os.environ.get("DUNKINGSHEEP_SOCKET")
             or os.environ.get("DUNKINGSHEEP_DIR") or "default")
    digest = __import__("hashlib").sha256(scope.encode("utf-8")).hexdigest()[:12]
    return os.path.join("/tmp", "dunkingsheep-gen-" + str(os.getuid()) + "-" + digest)


def _generation():
    try:
        with open(_generation_path(), encoding="utf-8") as handle:
            return handle.read().strip() or "0"
    except OSError:
        return "0"


def _bump_generation(phase="pre"):
    """Invalidate cached reads. Called BEFORE a mutating run and AGAIN after it.

    Both are needed, and the second is not belt-and-braces: a read that lands between
    the pre-bump and the write completing would otherwise cache a PRE-write answer
    under the NEW generation, and that answer would then look valid until the next
    mutation (VP follow-up on t89). The phase is in the value so a test can see that
    the post-run bump happened rather than inferring it.
    """
    path = _generation_path()
    try:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(f"{time.time()}-{phase}")
    except OSError:
        pass


_POLL_COMMANDS = ("status", "list", "ls", "poll")
_INBOX_POLLS = ("count", "list", "ls", "stats")


def _coalesce(argv):
    """Return (cache path, hit) for a poll command; path is None when uncacheable.

    Ten lanes polling faster than they can act is pure overhead, but a
    suppressed call must not lose the ANSWER: an interactive caller that asks
    once must still get the count. The cache stores stdout under the key; a
    coalesced caller replays it and marks stderr as cached. DUNKINGSHEEP_FRESH=1
    bypasses the cache for a caller that needs certainty.

    The key includes the SOCKET (and so the store behind it). Without it, two
    different stores share one entry and a caller can be handed another store's
    answer: a test asserting `total: 0` from its own temp daemon was handed
    `total: 163` from the live mailbox, and the same collision could report the
    live inbox to a sandboxed agent.
    """
    if os.environ.get("DUNKINGSHEEP_FRESH") == "1":
        return None, False
    try:
        minimum = float(os.environ.get("DUNKINGSHEEP_MIN_POLL_S", "2"))
    except ValueError:
        minimum = 2.0
    if minimum <= 0:
        return None, False
    words = [word for word in argv if not word.startswith("-")]
    if not words:
        return None, False
    if words[0] == "inbox":
        if len(words) < 2 or words[1] not in _INBOX_POLLS:
            return None, False
    elif words[0] not in _POLL_COMMANDS:
        return None, False
    # The key includes the ARGUMENTS, not just the command. Keying on the command
    # alone meant `inbox count alpha` and `inbox count beta` shared one entry, so a
    # caller asking about lane B was handed lane A's numbers - the same
    # correct-looking cache, scoped wrong, as the cross-store collision.
    import hashlib as _hashlib
    scope = os.environ.get("DUNKINGSHEEP_SOCKET") or os.environ.get("DUNKINGSHEEP_DIR") or "default"
    digest = _hashlib.sha256((" ".join(argv) + "|" + scope).encode("utf-8")).hexdigest()[:16]
    key = digest
    path = os.path.join("/tmp", "dunkingsheep-poll-" + str(os.getuid()) + "-" + key)
    now = time.time()
    try:
        last = os.path.getmtime(path)
    except OSError:
        last = 0.0
    if last and now - last < minimum:
        # ...and only if nothing has CHANGED since this answer was computed.
        stamp = os.path.join(path + ".gen")
        try:
            with open(stamp, encoding="utf-8") as handle:
                cached_generation = handle.read().strip()
        except OSError:
            cached_generation = None
        if cached_generation != _generation():
            return path, False          # a write happened: recompute, do not replay
        return path, True
    try:
        open(path, "a").close()
        os.utime(path, (now, now))
    except OSError:
        return None, False
    # Return the path even on creation: _run writes the fresh stdout there so
    # the next call inside the interval can replay it instead of a stub.
    return path, False


def _run(argv):
    """Run main(), caching the stdout of a coalescable command.

    A cache hit replays the previous stdout (same fields) and writes a
    {"coalesced": true, "cached": true} marker to stderr; the caller parses the
    same answer it would have parsed fresh.

    Replay happens ONLY on a hit. Replaying whenever a `.out` exists pinned the
    first answer forever: a 16-hour-old `status` (version 2.28.0, pid long dead)
    was still being served because the fresh path returned before it could
    overwrite the file. A cache that cannot expire is a stale answer generator.
    """
    mutating = _is_mutating(argv)
    path, hit = _coalesce(argv)
    if path and hit:
        try:
            with open(path + ".out", encoding="utf-8") as handle:
                cached = handle.read()
        except OSError:
            cached = ""
        if cached:
            sys.stdout.write(cached)
            print(json.dumps({"coalesced": True, "cached": True,
                              "interval_s": float(os.environ.get(
                                  "DUNKINGSHEEP_MIN_POLL_S", "2"))}),
                  file=sys.stderr)
            return 0
        # No cached answer yet: run fresh rather than return a silent stub.
    if not path:
        # Only a coalescable command needs its stdout captured for the cache.
        # Capturing everything replaced sys.stdout with a StringIO, which has
        # no .buffer, so `dunkingsheep mcp` (a byte-stream server) died on
        # start and every MCP client saw CONNECTION_CLOSED.
        code = main(argv)
        if mutating:
            _bump_generation("post")
        return code
    import contextlib
    import io
    buffer = io.StringIO()
    try:
        with contextlib.redirect_stdout(buffer):
            code = main(argv)
    except SystemExit as exc:
        # argparse --version/--help print inside the capture and then exit;
        # the captured text must still reach stdout. A STRING code is a named
        # refusal ("no entry 'x'"): it belongs on stderr with a failing exit,
        # and dropping it made refusals exit 1 with no message at all.
        if isinstance(exc.code, str):
            sys.stderr.write(f"error: {exc.code}\n")
            code = 2
        else:
            code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    output = buffer.getvalue()
    if path:
        try:
            with open(path + ".out", "w", encoding="utf-8") as handle:
                handle.write(output)
            with open(path + ".gen", "w", encoding="utf-8") as handle:
                handle.write(_generation())
        except OSError:
            pass
    sys.stdout.write(output)
    if mutating:
        # AFTER the run: a read that raced the write must not keep a pre-write answer
        # that now carries the pre-bump generation.
        _bump_generation("post")
    return code


def main(argv=None):
    parser = build_parser()
    words = list(argv if argv is not None else sys.argv[1:])
    if not words:
        parser.print_help()
        return 0
    _be_nice()
    _coalesce(words)
    args = parser.parse_args(words)
    command = args.command
    # A mutating command invalidates every cached READ for this store. Bumping
    # before the run means a read that races the write recomputes rather than
    # replaying a pre-write answer.
    if _is_mutating(words):
        _bump_generation()

    if command in ("guide", "help", "docs"):
        sys.stdout.write(guide(markdown=args.markdown))
        return 0
    if command == "mcp-map":
        sys.stdout.write(mcp_map_text(markdown=args.markdown))
        return 0
    if command == "mcp-setup":
        return run_mcp_setup(args)
    if command == "install":
        import dunk_guard
        result = dunk_guard.install_launcher(args.bin_dir)
        if getattr(args, "json", False):
            print(json.dumps(result, indent=2))
        else:
            for key, value in result.items():
                print(f"{key:<16} {value}")
            if not result["resolves_to"]:
                print("\nNote: %s is not on this shell's PATH." % args.bin_dir)
            print("\nSuperuser setup: run `dunkingsheep superuser recover` "
                  "from the VP pane, then `dunkingsheep superuser status`.")
        return 0
    if command == "guard":
        import dunk_guard
        if args.action == "install":
            result = dunk_guard.install(shadow_binary=not args.no_shadow)
        elif args.action == "install-tmux":
            result = dunk_guard.install_tmux()
        else:
            result = getattr(dunk_guard, args.action)()
        if getattr(args, "json", False):
            print(json.dumps(result, indent=2))
        else:
            for key, value in result.items():
                print(f"{key:<22} {value}")
            if args.action == "install":
                print("\nOpen a new shell (or run: export PATH=\"%s:$PATH\") so agents "
                      "pick it up." % dunk_guard.GUARD_DIR)
        return 0 if result.get("ok", True) else 1

    if command == "watchdog":
        # Local and read-only: evaluates the stores directly and never starts
        # the daemon. Only a live run talks to it, to deliver one digest.
        import dunk_watchdog
        error_file = os.path.expanduser(args.error_file)
        try:
            config = dunk_watchdog.load_config(os.path.expanduser(args.config))
        except dunk_watchdog.ConfigError as error:
            message = f"CONFIG: {error}"
            print(f"watchdog: refusing to start: {message}", file=sys.stderr)
            if not args.dry_run and not args.replay:
                # The dead-man carries this text to the VP; nothing is sent from here.
                os.makedirs(os.path.dirname(error_file) or ".", exist_ok=True)
                with open(error_file, "w", encoding="utf-8") as handle:
                    handle.write(message + "\n")
            return 2
        if os.path.exists(error_file) and not args.dry_run and not args.replay:
            os.remove(error_file)
        live = config["enabled"] and not config["dry_run"] and not args.dry_run and not args.replay
        if live and args.now is not None:
            # A live run stamps state and the heartbeat with `now`; a backdated one
            # would make the dead-man fire falsely (or stay silent). Refuse it.
            print("watchdog: refusing --now on a live run (use --dry-run or --replay)", file=sys.stderr)
            return 2
        now = args.now if args.now is not None else time.time()
        if args.replay:
            if args.replay_from is None or not args.replay_step:
                print("watchdog: --replay needs --from and --step", file=sys.stderr)
                return 2
            result = dunk_watchdog.replay(config, args.replay_from, args.replay_to or now, args.replay_step)
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                for rule_id, count in sorted(result["counts"].items()):
                    print(f"REPLAY rule={rule_id} would_notify_vp={count['vp']} would_page_owner={count['owner']}")
                for rule_id in result["not_replayable"]:
                    print(f"REPLAY rule={rule_id} not replayable")
                for entry in result["errors"]:
                    print(f"SKIPPED rule={entry['rule']} at={entry['at']} error={entry['error']}")
            return 0
        report = dunk_watchdog.run(config, now, dry_run_flag=args.dry_run)
        print(json.dumps(report, indent=2, sort_keys=True, default=str) if args.json
              else dunk_watchdog.render_text(report))
        # EXIT 0 EVEN WHEN THE ESCALATION FAILED (VP ruling 2026-10-24, after the
        # watchdog died on a stale mailbox and the fleet lost its observer for nine
        # minutes). The failure is not hidden: the run's output says DELIVERY FAILED
        # with target and reason, the state file keeps delivery_failure, and the
        # heartbeat is deliberately NOT refreshed so the dead-man pages through an
        # observer that does not depend on this delivery path.
        return 0
    if command == "usage":
        import dunk_usage
        try:
            config = dunk_usage.load_config(os.path.expanduser(args.config))
            results = dunk_usage.run(config, only=args.provider, max_age=args.max_age)
        except dunk_usage.UsageError as error:
            print(f"usage: {error}", file=sys.stderr)
            return 2
        print(json.dumps(results, indent=2, sort_keys=True) if args.json
              else dunk_usage.render_text(results))
        return 1 if any(item.get("status") == "error" for item in results) else 0
    if command == "watchdog-deadman":
        # Must not import dunk_watchdog: it has to work when the watchdog is broken.
        import dunk_watchdog_deadman
        from dunk_server import SOCKET_PATH, CONFIG_DIR
        args.daemon_path = SOCKET_PATH if args.daemon_path is None else os.path.expanduser(args.daemon_path)
        args.expected_dir = os.path.expanduser(args.expected_dir or CONFIG_DIR)
        return dunk_watchdog_deadman.main(args)
    if command == "serve":
        from dunk_server import SOCKET_PATH, run_daemon
        return run_daemon(
            socket_path=args.socket or SOCKET_PATH,
            state_file=args.state_file,
            log_to_file=not args.no_log_file,
        )
    if command == "tui":
        if args.socket:
            os.environ["DUNKINGSHEEP_SOCKET"] = args.socket
        from dunking_sheep_tui import main as tui_main
        tui_main()
        return 0
    if command == "mcp":
        if args.socket:
            os.environ["DUNKINGSHEEP_SOCKET"] = args.socket
        if args.self_pane:
            os.environ["HERDR_PANE_ID"] = args.self_pane
        from dunk_mcp import main as mcp_main
        mcp_main()
        return 0
    if command == "commands":
        from dunk_api import COMMANDS
        if args.json:
            print(json.dumps([
                {"name": c.name, "description": c.description,
                 "input_schema": c.input_schema(), "mcp_tool": c.mcp}
                for c in COMMANDS
            ], indent=2))
            return 0
        for cmd in COMMANDS:
            params = ", ".join(
                f"{key}{'*' if key in cmd.required else ''}" for key in cmd.params
            )
            flag = "" if cmd.mcp else "  [socket/cli only]"
            print(f"{cmd.name}({params}){flag}\n    {cmd.description}")
        return 0

    _check_send_body(args)
    if command in ("respawn-pane", "respawn"):
        _respawn_argv(args)   # local argv refusal before the socket is opened

    # Commands that read local files must not depend on the daemon. The digest is
    # injected at session start; making it wait for a socket would mean an agent
    # gets no standing rules exactly when the daemon is down.
    if command == "github":
        return _github_local(args)
    if command == "context" and args.context_command in CONTEXT_DAEMON_WRITES \
            and not getattr(args, "local", False):
        return _context_via_daemon(args)
    if command in LOCAL_ONLY_COMMANDS:
        result, printer = run_client_command(None, args)
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            printer(result)
        return 0

    try:
        # A send may ask the daemon to block for --wait seconds; the socket read
        # has to outlast that or the CLI reports a timeout for a send that is
        # in fact queued and fine.
        wait = getattr(args, "wait", None)
        client = FlockClient.connect_or_start(
            socket_path=args.socket, self_pane_id=args.self_pane,
            start=not args.no_start_daemon,
        )
        if command == "health" and getattr(args, "deep", False):
            # A deep quick_check scans the whole DB; give it room.
            client.timeout = max(client.timeout, 180.0)
        if wait:
            client.timeout = max(client.timeout, float(wait) + 10.0)
        client.timeout = client_timeout_for(command, client.timeout)
        # Synchronous send paths wait for the daemon to *deliver*, and delivery can
        # need several pane reads (a typing check, a dead-session check, a submit
        # confirmation). On a loaded host those reads are slow enough that the
        # client's default 15 s timed out a `fire` that was working perfectly.
        if command in ("fire", "send", "send-keys", "flush", "dunk"):
            client.timeout = max(client.timeout, SEND_TIMEOUT_S)
        if command in BATCH_COMMANDS:
            # A tick classifies every lane; it is a batch, not a single send, and a
            # 15 s socket timeout turned a working tick into a failed unit.
            client.timeout = max(client.timeout, BATCH_TIMEOUT_S)
        result, printer = run_client_command(client, args)
    except DunkError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    except socket.timeout:
        # The socket deadline, not the work: say so, and let the caller treat a slow
        # batch as 'not finished' rather than 'broken'.
        if command in BATCH_COMMANDS:
            print(_still_working_message(command, client.timeout), file=sys.stderr)
            return EXIT_STILL_WORKING
        print(f"error: no answer after {int(client.timeout)}s from the daemon", file=sys.stderr)
        return 3
    except (DaemonUnavailable, OSError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 3

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        printer(result)
    # THE EXIT CODE IS A CONTRACT, and it used to lie: a send that printed FAILED
    # still exited 0, so a caller trusting the code recorded a delivery that never
    # happened (cos measured it, 2026-10-24). Anything the daemon answers with
    # ok=false is a non-zero exit, whatever the prose says.
    if isinstance(result, dict) and result.get("ok") is False:
        # 2 is this CLI's existing "named refusal" code (see the DunkError path
        # below). A failed send is a refusal with a reason, not a new kind of exit.
        return 2
    return 0


def run_context_command(dunk_context, args):
    """The context store commands. Local files only: no socket, no daemon."""
    sub = args.context_command
    store = dunk_context.Store(args.path if getattr(args, "path", None) else None,
                               global_store=bool(getattr(args, "global_store", False)))
    if sub == "init":
        return {"root": str(store.ensure())}, lambda r: print(f"store at {r['root']}")
    if sub == "ledger":
        ledger = dunk_context.Ledger()
        if args.action == "adopt":
            if os.environ.get("DUNKINGSHEEP_SUPERUSER") != "1":
                raise SystemExit("refused: `context ledger adopt` is the owner's bootstrap; "
                                 "run it with DUNKINGSHEEP_SUPERUSER=1 from the owner's terminal")
            adopted = store.adopt(ledger=ledger, by="adopt")
            return {"adopted": adopted, "ledger": str(ledger.path)}, \
                lambda r: print(f"adopted {len(r['adopted'])} entries into {r['ledger']}")
        rows = []
        for entry in store.live_entries():
            rows.append({"slug": entry["slug"], "class": entry["class"],
                         "state": ledger.status(store.root, entry["slug"],
                                                open(entry["path"]).read())})
        return {"entries": rows, "count": ledger.count()}, \
            lambda r: [print(f"{e['state']:11} {e['class']:13} {e['slug']}") for e in r["entries"]] and None
    if sub in CONTEXT_DAEMON_WRITES:
        # --local writes the file only. It is NOT recorded in the ledger, so a
        # ground truth written this way is not injected until the owner runs
        # `context ledger adopt`: the daemon is the only path that records.
        store.ledger = None
    if sub == "add":
        if getattr(args, "text", None):
            body = args.text
        elif args.file == "-":
            body = sys.stdin.read()
        else:
            try:
                body = open(args.file).read()
            except FileNotFoundError:
                raise Refused(
                    f"no such file: {args.file!r} - the body comes from --text, stdin or a "
                    f"file; for text inline use: dunkingsheep context add --text "
                    f"'<claim>' --class ... --subject ...")
        return store.add(body, cls=args.cls, subject=args.subject, type_=args.type_,
                         authority=args.authority, source=args.source, stated=args.stated,
                         recheck_after=args.recheck_after, supersedes=args.supersedes), \
            lambda r: print(f"added {r['class']}/{r['slug']}")
    if sub == "promote":
        entry = store.find(args.slug)
        if entry is None:
            raise SystemExit(1)
        if os.environ.get("DUNKINGSHEEP_SUPERUSER") != "1":
            raise SystemExit("refused: only an owner act promotes a ground truth")
        return store.add(entry["body"], cls="ground-truth", subject=entry["subject"],
                         type_=entry.get("type") or "principle", authority="owner",
                         source=entry.get("source") or "",
                         supersedes=entry["slug"]), lambda r: print(f"promoted {r['slug']}")
    if sub == "supersede":
        body = sys.stdin.read() if args.file == "-" else open(args.file).read()
        return store.supersede(args.slug, body), lambda r: print(f"superseded by {r['slug']}")
    if sub == "retire":
        return store.retire(args.slug, args.reason), lambda r: print(f"retired {r['slug']}")
    if sub in ("get", "search"):
        # The same scope rule as stats/check/digest: a lookup must find a
        # global ground truth from inside a project, or the rules are write-only.
        which = ("global" if getattr(args, "global_store", False)
                 else "project" if getattr(args, "project", False) else None)
        stores = dunk_context.select_stores(getattr(args, "path", None), which=which)
        if sub == "get":
            for name, target in stores.items():
                entry = target.resolve(args.key)
                if entry is not None:
                    target.log_access(entry["slug"])
                    return entry, lambda r: print(
                        f"# {r['slug']} ({r['class']}, {r['authority']}, {name})\n\n{r['body']}")
            raise SystemExit(f"no entry {args.key!r} in {', '.join(stores) or 'any store'}")
        rows = []
        for name, target in stores.items():
            for row in target.search(args.query, cls=args.cls, scope=args.scope):
                rows.append(dict(row, store=name))
        return rows, lambda rs: [print(f"{r['store']:<8} {r['class']:<13} {r['slug']:<40} {r['subject']}")
                                 for r in rs] and None
    if sub == "digest":
        which = ("global" if getattr(args, "global_store", False)
                 else "project" if getattr(args, "project", False) else None)
        return dunk_context.digest_both(getattr(args, "path", None), which=which,
                                        max_bytes=args.max_bytes, subject=args.subject), print
    which = ("global" if getattr(args, "global_store", False)
             else "project" if getattr(args, "project", False) else None)
    if sub == "snapshot":
        import json as _json
        # One deterministic call for the dashboard: the digest exactly as an
        # agent receives it, plus per-article delivery and read counts.
        stores = dunk_context.select_stores(getattr(args, "path", None), which=which)
        data = {"schema": "context-snapshot/1", "as_of": int(time.time()),
                "digest": dunk_context.digest_both(getattr(args, "path", None), which=which,
                                                   record=False),
                "stores": {}}
        for name, target in stores.items():
            stats = target.stats()
            data["stores"][name] = {
                "status": "ok" if target.exists() else "absent",
                "path": str(target.root), "counts": stats["counts"],
                "reads_7d": stats["reads_7d"], "injected_7d": stats["injected_7d"],
                "never_read_count": stats["never_read_count"],
                "never_delivered_count": stats["never_delivered_count"],
                "entries": target.entry_stats()}
        return data, lambda d: print(_json.dumps(d, indent=2))
    if sub in ("check", "index", "stats"):
        stores = dunk_context.select_stores(getattr(args, "path", None), which=which)
        out = {}
        for name, target in stores.items():
            if sub == "index":
                out[name] = {"path": str(target.root), "result": target.index()}
            elif sub == "check":
                result = target.check()
                out[name] = {"path": str(target.root), "counts": result["counts"],
                             "refusals": len(result["refusals"]), "stale": len(result["stale"]),
                             "entries": sum(result["counts"].values())}
            else:
                result = target.stats()
                out[name] = {"path": str(target.root), "counts": result["counts"],
                             "reads_7d": result["reads_7d"],
                             "injected_7d": result["injected_7d"],
                             "never_read_count": result["never_read_count"],
                             "never_read": result["never_read"],
                             "never_delivered_count": result["never_delivered_count"]}
        if sub == "index":
            return out, lambda r: [print(f"{name}: indexed {v['result']['indexed']} -> {v['result']['path']}")
                                   for name, v in r.items()] and None
        if sub == "check":
            return out, lambda r: [print(f"{name} ({v['path']}): entries {v['entries']}, refusals {v['refusals']}, stale {v['stale']}")
                                   for name, v in r.items()] and None
        return out, lambda r: [print(f"{name} ({v['path']}): counts {v['counts']}, "
                                    f"injected_7d {v['injected_7d']}, reads_7d {v['reads_7d']}, "
                                    f"never_delivered {v['never_delivered_count']}, "
                                    f"never_read {v['never_read_count']}") for name, v in r.items()] and None


SHELL_SUBSTITUTION = ("`", "$(", "${")


def _check_send_body(args):
    """Guard the send path before anything else happens.

    Runs before the socket: a refusal that needs the daemon is a refusal that
    fails open when the daemon is down.
    """
    if getattr(args, "command", None) != "inbox" or getattr(args, "inbox_command", None) != "send":
        return
    from_file = getattr(args, "body_file", None)
    if from_file:
        return                      # read from a file: never passed through a shell
    _refuse_shell_substitution(" ".join(getattr(args, "body", []) or []),
                               getattr(args, "subject", None),
                               literal=bool(getattr(args, "literal", False)))


def _respawn_argv(args):
    """Parse and validate respawn argv in one place.

    Called both by the CLI dispatch and, before the socket is opened, by main().
    Malformed JSON is a local argument error; it must not be reported as a
    missing daemon, and a valid argv must still reach the normal daemon-absent
    refusal. This preflight is why the CLI regression can use a nonexistent
    socket and still exercise the dispatch parser.
    """
    try:
        argv = json.loads(args.command_json)
        rollback = json.loads(args.rollback_json) if args.rollback_json else None
    except ValueError as error:
        raise Refused(f"--command-json/--rollback-json must be JSON arrays: {error}")
    if not isinstance(argv, list) or not argv or not all(isinstance(x, str) for x in argv):
        raise Refused("--command-json must be a non-empty JSON array of strings")
    if rollback is not None and (not isinstance(rollback, list) or not rollback
                                 or not all(isinstance(x, str) for x in rollback)):
        raise Refused("--rollback-json must be a non-empty JSON array of strings")
    return argv, rollback


class Refused(SystemExit):
    """A named refusal: the message is the reason, the code is 2.

    `SystemExit("message")` exits 1 and loses the distinction between "refused,
    with a reason" and "crashed", which this CLI has kept for everything else
    (VP ruling 2026-10-24, after three tests caught the difference).
    """

    def __init__(self, message, code=2):
        self.message = str(message)
        super().__init__(code)

    def __str__(self):
        return self.message


def _refuse_shell_substitution(body, subject=None, *, literal=False):
    """Refuse a body the sending shell was free to rewrite.

    A backtick in an unquoted shell argument is executed before this program
    runs, so the word between the backticks disappears and the message arrives
    with a hole in it that only the reader can see. The failure is silent at the
    sending end, which is why it is worth a refusal.

    The honest limit: this guard CANNOT see what the shell already removed. It
    catches bodies where the syntax survived (double quotes, a heredoc that was
    not expanded), and it does that by refusing rather than guessing. For a body
    that must contain these characters, pass --literal; for a body that must
    never be touched by a shell, pass --body-file.
    """
    if literal:                      # the caller said "these characters are text"
        return
    for label, text in (("body", body), ("subject", subject)):
        if not text:
            continue
        for fragment in SHELL_SUBSTITUTION:
            index = text.find(fragment)
            if index < 0:
                continue
            around = text[max(0, index - 30):index + 30].replace("\n", " ")
            raise Refused(
                f"inbox send: the {label} contains shell-substitution syntax {fragment!r} "
                f"(...{around}...). An unquoted shell may have already rewritten it, and a "
                f"backtick pair deletes the word between them before this command runs. "
                f"Use single quotes, or pass --literal to send these characters as text, "
                  f"or --body-file PATH to bypass the shell entirely.")


def print_turn_end(result):
    """Say what the turn end DID, not only that it was recorded.

    Ending a turn now can prompt the lane immediately (trigger=turn.end). A one-line
    report that hid that would make the new mechanism invisible at the one place a
    person looks right after a turn ends, and a HELD nudge must read as held.
    """
    line = f"turn end {result['pane_id']} (ended={result['ended']})"
    dispatch = result.get("dispatch") or {}
    if dispatch.get("action") == "nudge":
        line += (f"; trigger=turn.end nudged {dispatch.get('task_id')}: "
                 + ("delivered" if dispatch.get("delivered")
                    else f"HELD, not delivered ({dispatch.get('outcome')})"))
    elif dispatch:
        line += f"; trigger=turn.end no nudge ({dispatch.get('reason')})"
    print(line)


def run_client_command(client, args):
    """Map CLI args onto a registry command; return (result, human printer)."""
    command = args.command
    if command == "status":
        return client.call("status", check_herdr=args.check_herdr), print_status
    if command == "turn":
        if args.turn_command == "start":
            return client.call("turn_start", pane=args.pane, ttl_s=args.ttl_s,
                               source=args.source, handoff_id=args.handoff_id), \
                lambda r: print(f"turn start {r['pane_id']} ttl {r['ttl_s']}s")
        return client.call("turn_end", pane=args.pane,
                           reason=args.reason, turn_id=args.turn_id), print_turn_end
    if command == "poll":
        payload = {"limit": args.limit, "panes": args.panes, "tasks": args.tasks,
                   "include_done": args.include_done,
                   "check_herdr": args.check_herdr}
        if args.mailbox:
            payload["mailbox"] = args.mailbox
        if args.task_scope:
            payload["task_scope"] = args.task_scope
        return client.call("poll", **payload), print_poll
    if command in ("list", "ls"):
        return client.call("list_dunks"), lambda r: print_dunks(r["dunks"])
    if command == "get":
        return client.call("get_dunk", id=args.id), print_dunk
    if command == "add":
        payload = {
            "text": args.text,
            "interval_minutes": args.every,
            "start": not args.no_start,
        }
        if args.target:
            payload["target"] = args.target
        if args.name:
            payload["name"] = args.name
        if args.only_idle:
            payload["only_when"] = "idle"
        if args.max_sends:
            payload["max_sends"] = args.max_sends
        if args.skip_if_unconsumed:
            payload["skip_if_unconsumed"] = True
        if args.ignore_typing:
            payload["hold_while_typing"] = False
        return client.call("add_dunk", **payload), print_dunk
    if command in ("update", "set"):
        payload = {"id": args.id}
        if args.target:
            payload["target"] = args.target
        if args.text is not None:
            payload["text"] = args.text
        if args.every is not None:
            payload["interval_minutes"] = args.every
        if args.name is not None:
            payload["name"] = args.name
        if args.only_idle:
            payload["only_when"] = "idle"
        elif args.any_time:
            payload["only_when"] = None
        if args.max_sends is not None:
            payload["max_sends"] = args.max_sends or None
        if args.skip_if_unconsumed:
            payload["skip_if_unconsumed"] = True
        elif args.always_send:
            payload["skip_if_unconsumed"] = False
        if args.hold_while_typing:
            payload["hold_while_typing"] = True
        elif args.ignore_typing:
            payload["hold_while_typing"] = False
        return client.call("update_dunk", **payload), print_dunk
    if command in ("remove", "rm", "delete"):
        return client.call("remove_dunk", id=args.id), lambda r: print(f"removed {r['id']}")
    if command == "start":
        return client.call("start_dunk", id=args.id), print_dunk
    if command == "stop":
        return client.call("stop_dunk", id=args.id), print_dunk
    if command == "toggle":
        return client.call("toggle_dunk", id=args.id), print_dunk
    if command == "stop-all":
        return client.call("stop_all"), lambda r: print_dunks(r["dunks"])
    if command in ("fire", "test"):
        result = client.call("fire_dunk", id=args.id, countdown_s=args.countdown, wait=True)
        return result, lambda r: print(
            f"{r['id']}: {'queued' if r.get('queued') else 'sent' if r['ok'] else 'FAILED'} "
            f"({r['message']})")
    if command == "send":
        result = client.call("send_text", target=args.target, text=" ".join(args.text),
                             hold_while_typing=not args.ignore_typing, wait_s=args.wait,
                             press_enter=not args.no_enter,
                             desk_token=getattr(args, "desk_token", None))
        return result, print_message
    if command == "send-keys":
        result = client.call("send_keys", target=args.target, keys=" ".join(args.keys),
                             hold_while_typing=not args.ignore_typing, wait_s=args.wait,
                             desk_token=getattr(args, "desk_token", None))
        return result, print_message
    if command == "inbox":
        sub = args.inbox_command
        if sub == "count":
            return client.call("inbox_count", mailbox=args.mailbox), print_inbox_count
        if sub == "send":
            body = " ".join(args.body)
            if getattr(args, "body_file", None):
                if args.body:
                    raise SystemExit("inbox send: pass a body or --body-file, not both")
                body = sys.stdin.read() if args.body_file == "-" else open(args.body_file).read()
            return client.call("inbox_send", to=args.to, body=body,
                               subject=args.subject,
                               attach=",".join(args.attach) if args.attach else None,
                               notify=not args.no_notify), print_inbox_sent
