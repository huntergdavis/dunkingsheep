def print_task_next(result):
    task = result.get("task")
    if not task:
        refused = result.get("refused") or {}
        reason = refused.get("reason")
        ids = refused.get("task_ids") or []
        owners = refused.get("owned_by") or []
        if reason == "busy":
            held = ", ".join(ids) or "in-progress work"
            print(f"refused (busy): this pane already holds {held}; "
                  f"pass --allow-busy to take parallel work")
        elif reason == "empty":
            print("no eligible task: the queue is empty for this scope")
        elif reason:
            detail = f" ({', '.join(ids)})" if ids else ""
            if owners:
                detail += f" owned by {', '.join(owners)}"
            print(f"no eligible task: refused ({reason}){detail}")
        else:
            print("no eligible task")
        if result.get("following"):
            print("following the queue: the daemon will push the next task "
                  "when this pane is idle")
        return
    print(f"claimed {task['id']} (lease {int(result.get('lease_seconds') or 0)}s)")
    print_task(task)


