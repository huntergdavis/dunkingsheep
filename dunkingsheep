    if r.get("oldest_unread_s"):
        line += f", oldest waiting {_every(r['oldest_unread_s'] / 60)}"
    if r.get("archived"):
        line += f", {r['archived']} archived"
    if r.get("undeliverable"):
        line += f", {r['undeliverable']} undeliverable"
    if r.get("from_lanes"):
        line += f", {r['from_lanes']} from lanes (bypassed a PM)"
    if r.get("attachments_unread"):
        line += f", {r['attachments_unread']} attachment(s)"
    print(line)


