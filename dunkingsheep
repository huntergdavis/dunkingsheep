def _task_row(task):
    scope = "global" if task.get("is_global") else task.get("scope")
    assignees = ",".join(task.get("assignees") or []) or "-"
    return (f"{task['id']:<5} {task['status']:<11} {task['priority']:<6} "
            f"{_clip(scope, 10):<10} {_clip(assignees, 18):<18} "
            f"{_clip(task['title'], 50)}")


def print_task(task):
    print(f"{task['id']} [{task['priority']}] {task['status']}  {task['title']}")
    print(f"scope       {task['scope']}")
    if task.get("assignees"):
        print(f"assignees   {', '.join(task['assignees'])}")
    if task.get("claimed_by"):
        print(f"claimed by  {', '.join(task['claimed_by'])}")
    if task.get("depends_on"):
        blocked = task.get("blocked_by") or []
        print(f"depends on  {', '.join(task['depends_on'])}"
              + (f" (blocked by {', '.join(blocked)})" if blocked else ""))
    if task.get("parent_id"):
        print(f"parent      {task['parent_id']}")
    if task.get("block_reason"):
        print(f"blocked     {task['block_reason']}")
    if task.get("body"):
        print()
        print(task["body"])
    if task.get("children"):
        print()
        print("subtasks:")
        for child in task["children"]:
            print("  " + _task_row(child))
    if task.get("lease_expires_at"):
        print(f"lease       {time.strftime('%Y-%m-%d %H:%M:%S',
                                        time.localtime(task['lease_expires_at']))}")


def print_task_list(result):
    tasks = result.get("tasks") or []
    print(f"scope {result.get('scope')} (pane {result.get('pane_id') or '-'})")
    if not tasks:
        print("no tasks")
        return
    print(f"{'ID':<5} {'STATUS':<11} {'PRIORITY':<6} {'SCOPE':<10} "
          f"{'ASSIGNEES':<18} TITLE")
    for task in tasks:
        print(_task_row(task))


def print_task_next(result):
    task = result.get("task")
    if not task:
        print("no eligible task")
        if result.get("following"):
            print("following the queue: the daemon will push the next task "
                  "when this pane is idle")
        return
    print(f"claimed {task['id']} (lease {int(result.get('lease_seconds') or 0)}s)")
    print_task(task)


