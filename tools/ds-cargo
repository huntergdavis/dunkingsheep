#!/usr/bin/env bash
# CI-matched DS toolchain; locking shared with other projects via proj-cargo.
set -euo pipefail
toolchain=${DS_CARGO_TOOLCHAIN:-/home/hunter/.local/share/dunkingsheep/toolchains/rustup/toolchains/1.99.1-x86_64-unknown-linux-gnu/bin}
if [[ ! -x $toolchain/cargo || ! -x $toolchain/rustc ]]; then
    echo 'CI-matched Rust1.99.1 is not ready; use exact-head CI and record local NOT RUN.' >&2
    exit 75
fi
export PATH="$toolchain:$PATH"
export RUSTC="$toolchain/rustc"
export RUSTDOC="$toolchain/rustdoc"
export RUSTFLAGS=${RUSTFLAGS:--D warnings}
export PROJ_CARGO_TIMEOUT_SECONDS=${DS_CARGO_TIMEOUT_SECONDS:-3600}
# t3912: test and build-script temp files go to a SHORT per-checkout directory on the workspace
# disk, not the small shared /tmp: ~/workspace/.dunk-scratch/c/<8 hex of the checkout path>.
# Short, because tests make Unix sockets under it and a socket path may have only 107 bytes;
# a directory longer than DS_CARGO_TMP_MAX (56) is refused with an error instead of used.
# The lane's own TMPDIR is NOT kept: a new lane's TMPDIR is ~/workspace/.dunk-scratch/<name>-<hex>
# (up to 60 bytes), which would leave 2 bytes of socket margin. DS_CARGO_TMPDIR=<dir> is the one
# explicit override. Outside a git checkout nothing changes.
scratch=
if [[ -n ${DS_CARGO_TMPDIR:-} ]]; then
    scratch=$DS_CARGO_TMPDIR
    if [[ $scratch != /* ]]; then
        echo "ds-cargo: DS_CARGO_TMPDIR must be an absolute path, not $scratch" >&2
        exit 2
    fi
    if [[ ${scratch%/} == /tmp || $scratch == /tmp/* ]]; then
        echo "ds-cargo: DS_CARGO_TMPDIR may not be under /tmp (the small shared tmpfs): $scratch" >&2
        exit 2
    fi
    # On the workspace disk (~/workspace) or under a root named in DS_CARGO_TMP_ROOTS (colon list).
    allowed=0
    IFS=: read -r -a roots <<< "${HOME:?HOME is not set}/workspace${DS_CARGO_TMP_ROOTS:+:$DS_CARGO_TMP_ROOTS}"
    for root in "${roots[@]}"; do
        [[ -n $root && ( $scratch == "${root%/}" || $scratch == "${root%/}"/* ) ]] && allowed=1
    done
    if (( ! allowed )); then
        echo "ds-cargo: DS_CARGO_TMPDIR must be under ~/workspace or a root in DS_CARGO_TMP_ROOTS: $scratch" >&2
        exit 2
    fi
elif top=$(git rev-parse --show-toplevel 2>/dev/null); then
    key=$(printf '%s' "$top" | sha256sum | cut -c1-8)
    scratch=${HOME:?HOME is not set}/workspace/.dunk-scratch/c/$key
    mkdir -p -m 700 -- "$HOME/workspace/.dunk-scratch" "$HOME/workspace/.dunk-scratch/c"
fi
if [[ -n $scratch ]]; then
    # The same rule for the default and the override: short enough for socket paths under it.
    if (( ${#scratch} > ${DS_CARGO_TMP_MAX:-56} )); then
        echo "ds-cargo: scratch directory $scratch is ${#scratch} bytes, over ${DS_CARGO_TMP_MAX:-56}; Unix socket paths under it would not fit. Set DS_CARGO_TMPDIR to a shorter absolute directory." >&2
        exit 2
    fi
    mkdir -p -m 700 -- "$scratch"
    export TMPDIR=$scratch
fi
exec "$(dirname -- "$(readlink -f -- "$0")")/proj-cargo" dunkingsheep "$@"
