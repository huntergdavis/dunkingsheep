+	// Serialize hook commands: a fast settled event must wait for start's token.
+	let turnEvents = Promise.resolve();
+	let activeTurnId: string | undefined;
+	function turn(kind: "start" | "end", cwd: string, prompt = ""): Promise<void> {
+		turnEvents = turnEvents.then(async () => {
+			try {
+				if (kind === "start") {
+					activeTurnId = undefined;
+					const args = ["--json", "turn", "start", "--source", "pi-extension"];
+					const handoff = prompt.match(/\bHandoff (nj-[0-9a-f]{32})\./);
+					if (handoff) args.push("--handoff-id", handoff[1]);
+					const result = await pi.exec(DUNK_BIN, args, { cwd, timeout: 10_000 });
+					const response = JSON.parse(result.stdout);
+					if (result.code === 0 && typeof response.turn_id === "string" && response.turn_id) {
+						activeTurnId = response.turn_id;
+					}
+				} else {
+					const turnId = activeTurnId;
+					activeTurnId = undefined;
+					if (turnId) {
+						await pi.exec(DUNK_BIN, ["turn", "end", "--turn-id", turnId], { cwd, timeout: 10_000 });
+					}
+				}
+			} catch {
+				activeTurnId = undefined;
+				// Failed/missing start evidence never becomes an unbound end; TTL is the backstop.
+			}
+		});
+		return turnEvents;
 	}
 
